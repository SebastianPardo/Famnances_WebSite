@model Famnances.Models.ViewModels.HomeViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Home Page";
}

@if (Model.ToBeClosed)
{
    <div class="row justify-content-center">
        <div class=" col-12 mb-4 text-center">
            <a asp-action="ClosePeriod" class="btn btn-danger">Close Period</a>
        </div>
    </div>
}
<div class="row">
    <div class=" col-12 mb-1">
        <div class="card minicard">
            <div class="card-body">
                <div class="card-title">
                    <div class="col-12 align-items-start">
                        <span class="d-block h3">Balance</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12 d-flex justify-content-between">
                        <span class="fw-semibold d-flex d-block h4 mb-0">Mensualmente</span>
                        <span class="fw-semibold d-block text-primary h4 mb-0">$@Model.PeriodBudget</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="progress" role="progressbar" aria-label="Success example" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-secondary" style="width: 25%"></div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 d-flex justify-content-between">
                        @{
                            var spent = Model.PeriodBudget - Model.PeriodBalance;
                        }
                        <span class="d-flex d-block h6 mb-0">@spent spent</span>
                        <span class="d-block text-primary h6 mb-0">$@Model.PeriodBalance left</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class=" col-12 mb-1">
        <div class="card minicard">
            <div class="card-body">
                <div class="row align-items-center justify-content-between">
                    <div class="col-2 text-center bg-primary rounded-circle d-flex align-items-center justify-content-center ms-2">
                        <i class="bi bi-bank text-white fs-1"></i>
                    </div>
                    <div class="col-9">
                        <span class="fw-semibold d-block h3 mb-0">@Localizer["ChequingAccount"]</span>
                        <span class="fw-semibold d-block text-primary h3 mb-0">$@Model.Chequing</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class=" col-12 mb-1">
        <div class="card minicard">
            <div class="card-body">
                <div class="row align-items-center justify-content-between">
                    <div class="col-2 text-center bg-tertiary rounded-circle d-flex align-items-center justify-content-center ms-2">
                        <i class="bi bi-piggy-bank text-white fs-1"></i>
                    </div>
                    <div class="col-9">
                        <span class="fw-semibold d-block h3 mb-0">@Localizer["SavingsAccount"]</span>
                        <span class="fw-semibold d-block text-tertiary h3 mb-0">$@Model.Savings</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class=" col-12 mb-1">
        <div class="card minicard">
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-12 d-flex justify-content-between">
                        <span class="fw-semibold d-flex d-block h4 mb-0">Savings balance</span>
                        <span class="fw-semibold d-block text-primary h4 mb-0">$@Model.Savings</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="progress" role="progressbar" aria-label="Success example" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-secondary" style="width: 25%"></div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 d-flex justify-content-between">
                        @{
                            var savingsSpent = Model.Savings - Model.PeriodSavingsExpeses;
                        }
                        <span class="d-flex d-block h6 mb-0">$@savingsSpent spent</span>
                        <span class="d-block text-primary h6 mb-0">$@Model.PeriodSavingsExpeses left</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class=" col-12 mb-1">
        <div class="card minicard">
            <div class="card-body">
                <div class="row align-items-center justify-content-between">
                    <div class="col-2 text-center bg-secondary rounded-circle d-flex align-items-center justify-content-center ms-2">
                        <i class="bi bi-piggy-bank-fill text-white fs-1"></i>
                    </div>
                    <div class="col-9">
                        <span class="fw-semibold d-block h3 mb-0">@Localizer["HomeSavings"]</span>
                        <span class="fw-semibold d-block text-secondary h3 mb-0">$@Model.HomeSavings</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <span class="fw-semibold d-block mb-2 mt-4 h4">@Localizer["FixedExpenses"]</span>
        <div class="col-md">
            <div id="accordionIcon" class="accordion mt-3 accordion-without-arrow">

                @{
                    int i = 1;
                }
                @foreach (var roommate in Model.Roommates)
                {
                    <div class="accordion-item card mb-2 bg-card">
                        <h2 class="accordion-header text-body d-flex justify-content-between fw-semibold" id="accordionIcon_@i">
                            <button type="button" class="accordion-button collapsed bg-card text-black pb-0" data-bs-toggle="collapse" data-bs-target="#accordionIcon-@i" aria-controls="accordionIcon-@i">
                                @roommate.Name
                            </button>
                        </h2>
                        <div class="row">
                            <div class="col-12 d-flex justify-content-end mb-1">
                                <span class="d-block text-black h6 mb-0 me-2 small">$50/$100 paid</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="progress" role="progressbar" aria-label="Success example" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" style="height:6px">
                                    <div class="progress-bar bg-primary" style="width: 25%"></div>
                                </div>
                            </div>
                        </div>
                        <div id="accordionIcon-@i" class="accordion-collapse collapse" data-bs-parent="#accordionIcon">
                            <div class="accordion-body">
                                <ul class="list-group">
                                    @foreach (var fixedExpense in roommate.SummaryFixedExpenses)
                                    {
                                        <li class="list-group-item">
                                            <div class="row">
                                                <div class="col-6 col-md-6 position-relative">
                                                    @if (fixedExpense.Id != Guid.Empty)
                                                    {
                                                        <a class="stretched-link" asp-controller="Outflows" asp-action="DetailsFixedExpenses" asp-route-id=@fixedExpense.Id></a>
                                                    }
                                                    <div class="row">
                                                        <div class="col text-primary"><h5 class="mb-0">@fixedExpense.Name</h5></div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col text-primary"><small class="mb-0">$@fixedExpense.Value</small></div>
                                                    </div>
                                                </div>
                                                <div class="col-6 col-md-6">
                                                    <div class="col-md-auto text-end fw-semibold">
                                                        @if (!fixedExpense.WasPaid)
                                                        {
                                                            @if (roommate.IsCurrentUser)
                                                            {
                                                                <form asp-controller="Outflows" asp-action="PayFixedExpenses" asp-route-id="@fixedExpense.Id" method="post" style="display:inline;">
                                                                    <button type="submit" class="btn btn-tertiary">@Localizer["Pay"]</button>
                                                                </form>
                                                            }
                                                            else
                                                            {
                                                                <h5 class="text-danger mb-0">@Localizer["Unpaid"]</h5>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <h5 class="text-success mb-0">@Localizer["Paid"]</h5>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    i++;
                }
            </div>
        </div>
    </div>
    <div class="col-12">
        <span class="fw-semibold d-block mt-4 mb-2 h4">@Localizer["Budgets"]</span>
        <div class="col-md">
            <div id="accordionIcon" class="accordion mt-3 accordion-without-arrow">
                @foreach (var roommate in Model.Roommates)
                {
                    <div class="accordion-item card mb-2 bg-card">
                        <h2 class="accordion-header text-body d-flex justify-content-between fw-semibold" id="accordionIcon_@i">
                            <button type="button" class="accordion-button collapsed bg-card text-black pb-0" data-bs-toggle="collapse" data-bs-target="#accordionIcon-@i" aria-controls="accordionIcon-@i">
                                @roommate.Name
                            </button>
                        </h2>
                        <div class="row">
                            <div class="col-12 d-flex justify-content-end mb-1">
                                <span class="d-block text-black h6 mb-0 me-2 small">$50/$100 used</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="progress" role="progressbar" aria-label="Success example" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" style="height:6px">
                                    <div class="progress-bar bg-primary" style="width: 25%"></div>
                                </div>
                            </div>
                        </div>

                        <div id="accordionIcon-@i" class="accordion-collapse collapse" data-bs-parent="#accordionIcon">
                            <div class="accordion-body">
                                <ul class="list-group">
                                    @foreach (var budget in roommate.SummaryBudgets)
                                    {
                                        var balance = budget.Budget - budget.Spent;
                                        if (budget.Id != Guid.Empty)
                                        {
                                            <a class="stretched-link" asp-controller="Budgets" asp-action="Details" asp-route-id=@budget.Id></a>
                                        }
                                        <li class="list-group-item">
                                            <div class="row mb-2">
                                                <div class="col-12 d-flex justify-content-between">
                                                    <span class="fw-semibold d-flex d-block h5 mb-0">@budget.Name</span>
                                                    <span class="fw-semibold d-block text-primary h5 mb-0">$@budget.Budget</span>
                                                </div>
                                            </div>
                                            <div class="row mb-2">
                                                <div class="col-12">
                                                    <div class="progress"
                                                         role="progressbar"
                                                         aria-label="Success example"
                                                         aria-valuenow="25" aria-valuemin="0"
                                                         aria-valuemax="100"
                                                         style="height:8px">
                                                        <div class="progress-bar bg-secondary" style="width: 25%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-12 d-flex justify-content-between">
                                                    <span class="d-flex d-block small mb-0">$@budget.Spent spent</span>
                                                    <span class="d-block text-primary small mb-0">$@balance left</span>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    i++;
                }
            </div>
        </div>
    </div>
    <div class="col-12">
        <span class="fw-semibold d-block mt-4 mb-2 h4">@Localizer["SavingPockets"]</span>
        <div class="col-md">
            <div id="accordionIcon" class="accordion mt-3 accordion-without-arrow">
                @foreach (var roommate in Model.Roommates)
                {
                    <div class="accordion-item card mb-2 bg-card">
                        <h2 class="accordion-header text-body d-flex justify-content-between fw-semibold" id="accordionIcon_@i">
                            <button type="button"
                                    class="accordion-button collapsed bg-card text-black pb-0"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#accordionIcon-@i"
                                    aria-controls="accordionIcon-@i">
                                @roommate.Name
                            </button>
                        </h2>
                        <div class="row">
                            <div class="col-12 d-flex justify-content-end mb-1">
                                <span class="d-block text-black h6 mb-0 me-2 small text-danger">$50 spent</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="progress" role="progressbar" aria-label="Success example" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" style="height:6px">
                                    <div class="progress-bar bg-primary" style="width: 25%"></div>
                                </div>
                            </div>
                        </div>

                        <div id="accordionIcon-@i" class="accordion-collapse collapse" data-bs-parent="#accordionIcon">
                            <div class="accordion-body">
                                <ul class="list-group">
                                    @foreach (var pocket in roommate.SummaryPockets)
                                    {
                                        <li class="list-group-item">
                                            @if (pocket.Id != Guid.Empty)
                                            {
                                                <a class="stretched-link" asp-controller="Savings" asp-action="DetailsPocket" asp-route-id=@pocket.Id></a>
                                            }

                                            <div class="row mb-2">
                                                <div class="col-12 d-flex justify-content-between">
                                                    <span class="fw-semibold d-flex d-block h5 mb-0">@pocket.Name</span>
                                                    <span class="fw-semibold d-block text-primary h5 mb-0">$@pocket.Value</span>
                                                </div>
                                            </div>
                                            <div class="row mb-2">
                                                <div class="col-12">
                                                    <div class="progress"
                                                         role="progressbar"
                                                         aria-label="Success example"
                                                         aria-valuenow="25" aria-valuemin="0"
                                                         aria-valuemax="100"
                                                         style="height:8px">
                                                        <div class="progress-bar bg-secondary" style="width: 25%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-12 d-flex justify-content-between">
                                                    <span class="d-flex d-block small mb-0">$@pocket.Spent spent</span>
                                                    <span class="d-block text-primary small mb-0">$0 left</span>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    i++;
                }
            </div>
        </div>
    </div>
</div>