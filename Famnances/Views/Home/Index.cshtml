                <a class="stretched-link" asp-controller="Savings" asp-action="Index"></a>
                <div class="card-title d-flex">
                    <div class="col-11 d-flex align-items-start">
                        <div class="avatar flex-shrink-0 me-2">
                            <img src="~/images/icons/piggy.png"
                                 alt="chart success"
                                 class="rounded" />
                        </div>
                        <span class="fw-semibold d-block mb-1 fs-4">Savings Account</span>
