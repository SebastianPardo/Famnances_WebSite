<div class="row">
    <div class="col-sm-12 col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="card-title d-flex">
                    <span class="fw-semibold d-block mb-1 fs-4">Fixed Expenses</span>
                </div>
                <div class="col-md">
                    <div id="accordionIcon" class="accordion mt-3 accordion-without-arrow">

                        @{
                            int i = 1;
                        }
                        @foreach (var roommate in Model.Roommates)
                        {
                            <div class="accordion-item card">
                                <h2 class="accordion-header text-body d-flex justify-content-between fw-semibold" id="accordionIcon_@i">
                                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionIcon-@i" aria-controls="accordionIcon-@i">
                                        @roommate.Name
                                    </button>
                                </h2>

                                <div id="accordionIcon-@i" class="accordion-collapse collapse" data-bs-parent="#accordionIcon">
                                    <div class="accordion-body">
                                        <ul class="list-group">
                                            @foreach (var fixedExpense in roommate.SummaryFixedExpenses)
                                            {
                                                <li class="list-group-item">
                                                    <div class="row">
                                                        <div class="col-6 col-md-6">
                                                            <div class="row">
                                                                <div class="col text-primary"><h5 class="mb-0">@fixedExpense.Name</h5></div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="col text-primary"><small class="mb-0">$@fixedExpense.Value</small></div>
                                                            </div>
                                                        </div>
                                                        <div class="col-6 col-md-6">
                                                            <div class="col-md-auto text-end fw-semibold">
                                                                @if (fixedExpense.Id != Guid.Empty)
                                                                {
                                                                    @if (fixedExpense.Owner)
                                                                    {
                                                                        <form asp-action="PayFixedExpenses" asp-route-id="@fixedExpense.Id" method="post" style="display:inline;">
                                                                            <button type="submit" class="btn btn-indigo">Pay</button>
                                                                        </form>
                                                                    }
                                                                    else
                                                                    {
                                                                        <h5 class="text-danger mb-0">Unpaid</h5>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <h5 class="text-success mb-0">Paid</h5>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            i++;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="card-title d-flex">
                    <span class="fw-semibold d-block mb-1 fs-4">Budgets</span>
                </div>
                <div class="col-md">
                    <div id="accordionIcon" class="accordion mt-3 accordion-without-arrow">
                        @foreach (var roommate in Model.Roommates)
                        {
                            <div class="accordion-item card">
                                <h2 class="accordion-header text-body d-flex justify-content-between fw-semibold" id="accordionIcon_@i">
                                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionIcon-@i" aria-controls="accordionIcon-@i">
                                        @roommate.Name
                                    </button>
                                </h2>

                                <div id="accordionIcon-@i" class="accordion-collapse collapse" data-bs-parent="#accordionIcon">
                                    <div class="accordion-body">
                                        <ul class="list-group">
                                            @foreach (var budget in roommate.SummaryBudgets)
                                            {
                                                var balance = budget.Value - budget.Spent;
                                                <li class="list-group-item">
                                                    <div class="row">
                                                        <div class="col-6 col-md-6 text-primary"><h5 class="mb-0">@budget.Name</h5></div>
                                                        <div class="col-6 col-md-6 text-end fw-semibold align-self-end"><h5 class="text-success mb-0">$@balance</h5></div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-6 col-md-6 text-start text-primary"><small class="mb-0">$@budget.Value</small></div>
                                                        <div class="col-6 col-md-6 text-end fw-semibold"><small class="text-danger mb-0"><i class="bx bx-down-arrow-alt"></i>$@budget.Spent</small></div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            i++;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="card-title d-flex">
                    <span class="fw-semibold d-block mb-1 fs-4">Savings Pockets</span>
                </div>
                <div class="col-md">
                    <div id="accordionIcon" class="accordion mt-3 accordion-without-arrow">
                        @foreach (var roommate in Model.Roommates)
                        {
                            <div class="accordion-item card">
                                <h2 class="accordion-header text-body d-flex justify-content-between fw-semibold" id="accordionIcon_@i">
                                    <button type="button"
                                            class="accordion-button collapsed"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#accordionIcon-@i"
                                            aria-controls="accordionIcon-@i">
                                        @roommate.Name
                                    </button>
                                </h2>

                                <div id="accordionIcon-@i" class="accordion-collapse collapse" data-bs-parent="#accordionIcon">
                                    <div class="accordion-body">
                                        <ul class="list-group">
                                            @foreach (var pocket in roommate.SummaryPockets)
                                            {
                                                <li class="list-group-item">
                                                    <div class="row">
                                                        <div class="col-6 col-md-6 text-primary"><h5 class="mb-0">@pocket.Name</h5></div>
                                                        <div class="col-6 col-md-6 text-end fw-semibold"><h5 class="text-success mb-0">$@pocket.Value</h5></div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col text-end fw-semibold"><small class="text-danger "><i class="bx bx-down-arrow-alt mb-0"></i>$@pocket.Spent</small></div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            i++;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>