@model Famnances.DataCore.ServicesModels.SummaryModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
    <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between mb-4">
                    <div class="col-11 d-flex align-items-start">
                        <div class="avatar flex-shrink-0 me-2">
                            <img src="~/images/icons/calendar.png"
                                 alt="chart success"
                                 class="rounded" />
                        </div>
                        <span class="fw-semibold d-block mb-1 fs-4 me-2">Period</span>
                    </div>
                </div>
                <div class="col text-end">
                    <h5 class="card-title mb-2 text-primary">@Model.PeriodStartDate.ToString("MMM dd, yyyy")  -  @Model.PeriodEndDate.ToString("MMM dd, yyyy")</h5>
                </div>
                @* <small class="text-success fw-semibold"><i class="bx bx-up-arrow-alt"></i> +72.80%</small> *@
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="card-title d-flex">
                    <div class="col-11 d-flex align-items-start">
                        <div class="avatar flex-shrink-0 me-2">
                            <img src="~/images/icons/wallet-dark.png"
                                 alt="chart success"
                                 class="rounded" />
                        </div>
                        <span class="fw-semibold d-block mb-1 fs-4">Budget</span>
                    </div>
                </div>
                <div class="col text-end">
                    <h3 class="card-title mb-2 text-secondary">$@Model.PeriodBudget</h3>
                </div>
                @* <small class="text-success fw-semibold"><i class="bx bx-up-arrow-alt"></i> +72.80%</small> *@
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-12 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between">
                    <div class="col-11 d-flex align-items-start">
                        <div class="avatar flex-shrink-0 me-2">
                            <img src="~/images/icons/bank.png"
                                 alt="chart success"
                                 class="rounded" />
                        </div>
                        <span class="fw-semibold d-block mb-1 fs-4 me-2">Current balance</span>
                    </div>
                    <div class="col-1 align-items-end">
                        <div class="dropdown">
                            <button class="btn p-0"
                                    type="button"
                                    id="cardOpt3"
                                    data-bs-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="false">
                                <i class="bx bx-dots-vertical-rounded"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="cardOpt3">
                                @* <a class="dropdown-item" href="javascript:void(0);">View More</a> *@
                                <a class="dropdown-item" href="javascript:void(0);">Details</a>
