                                <a class="dropdown-item" href="javascript:void(0);">Details</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col text-end">
                    <h3 class="card-title mb-2 text-danger">$@Model.PeriodExpenses</h3>
