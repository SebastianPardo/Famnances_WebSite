@using Famnances.Helpers


@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Famnances</title>

    <link rel="apple-touch-icon" href="~/images/logos/apple-touch-icon.png" asp-append-version="true" />
    <meta name="apple-mobile-web-app-title" content="Famnances">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- CSS only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/2.3.1/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/3.0.4/css/responsive.dataTables.min.css" rel="stylesheet" />


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3004437161279642" crossorigin="anonymous"></script>
</head>
<body style="background-color:var(--bs-teal);">
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="row justify-content-center align-items-center">
                <div class="col-12 col-md-4 p-0">
                    <div class="card">
                        <div class="card-body">
                            <div class="row mb-2 justify-content-center align-items-center">
                                <div class="col-12">
                                    <img src="~/images/logos/logo.png" class="rounded mx-auto d-block" style="max-width:100%" />
                                </div>
                            </div>
                            <hr class="mb-4" />
                            <div class="row text-center justify-content-center">
                                <div class="col-1 col-md-1">
                                    <a class="btn-primary" asp-controller="Home" asp-action="PreviousPeriod"><i class="bi bi-chevron-left"></i></a>
                                </div>
                                <div class="col-10 col-md-10">
                                    <h6 class="fw-semibold">
                                        @DateTime.Parse(Context.Session.GetString(Constants.DATE_FROM)).ToString("MMM dd, yyyy").ToUpper()
                                        -
                                        @DateTime.Parse(Context.Session.GetString(Constants.DATE_TO)).ToString("MMM dd, yyyy").ToUpper()
                                    </h6>
                                </div>
                                <div class="col-1 col-md-1">
                                    <a class="btn-primary" asp-controller="Home" asp-action="NextPeriod"><i class="bi bi-chevron-right"></i></a>
                                </div>
                            </div>
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="panel-overlay"></div>
    <div id="menu-wrapper">
        <nav class="col-12 col-md-4">
            <div id="more-panel">
                <div class="nav-item dropup">
                    <a class="dropdown-toggle btn panel-btn justify-content-center" data-bs-toggle="dropdown">@Localizer["Savings"]</a>
                    <div class="dropdown-menu m-0">
                        <a asp-controller="Savings" asp-action="Index" class="dropdown-item">@Localizer["Transactions"]</a>
                        <a asp-controller="Savings" asp-action="IndexPockets" class="dropdown-item">@Localizer["Pockets"]</a>
                        <a asp-controller="Savings" asp-action="IndexFixed" class="dropdown-item">@Localizer["FixedSavings"]</a>
                    </div>
                </div>
                <div class="nav-item dropup">
                    <a class="dropdown-toggle btn panel-btn justify-content-center" data-bs-toggle="dropdown">@Localizer["Incomes"]</a>
                    <div class="dropdown-menu m-0">
                        <a asp-controller="Inflows" asp-action="Index" class="dropdown-item">@Localizer["Incomes"]</a>
                        <a asp-controller="Inflows" asp-action="IndexFixedIncomes" class="dropdown-item">@Localizer["FixedIncomes"]</a>
                        <a asp-controller="IncomeDiscounts" asp-action="Index" class="dropdown-item">@Localizer["Discounts"]</a>
                    </div>
                </div>
                <div class="nav-item dropup">
                    <a class="dropdown-toggle btn panel-btn justify-content-center" data-bs-toggle="dropdown">@Localizer["Expenses"]</a>
                    <div class="dropdown-menu m-0">
                        <a asp-controller="Outflows" asp-action="Index" class="dropdown-item">@Localizer["Expenses"]</a>
                        <a asp-controller="Outflows" asp-action="IndexFixedExpenses" class="dropdown-item">@Localizer["FixedExpenses"]</a>
                        <a asp-controller="Budgets" asp-action="Index" class="dropdown-item">@Localizer["Budgets"]</a>
                    </div>
                </div>
                <div class="nav-item dropup">
                    <a class="dropdown-toggle btn panel-btn justify-content-center" data-bs-toggle="dropdown">@Localizer["Profile"]</a>
                    <div class="dropdown-menu m-0">
                        <a asp-controller="Users" asp-action="CreateHome" class="dropdown-item">@Localizer["Household"]</a>
                        <a asp-controller="Users" asp-action="Details" class="dropdown-item">@Localizer["Account"]</a>
                    </div>
                </div>
                <a class="btn panel-btn justify-content-center" asp-controller="Login" asp-action="Logout"><span>@Localizer["Logout"]</span></a>
            </div>

            <div id="add-panel">
                <a class="btn panel-btn" asp-controller="Inflows" asp-action="Create">
                    <i class="bi bi-arrow-down-circle" style="color:var(--bs-success);"></i>
                    <span>@Localizer["AddIncome"]</span>
                </a>
                <a class="btn panel-btn" asp-controller="Outflows" asp-action="Create">
                    <i class="bi bi-arrow-up-circle" style="color:var(--bs-danger)"></i>
                    <span>@Localizer["AddExpense"]</span>
                </a>
                <a class="btn panel-btn" asp-controller="Savings" asp-action="Create">
                    <i class="bi bi-piggy-bank" style="color:var(--bs-tertiary)"></i>
                    <span>@Localizer["AddWithdrawSavings"]</span>
                </a>
                <a class="btn panel-btn" asp-controller="Savings" asp-action="PocketTransfer">
                    <i class="bi bi-arrow-left-right" style="color:var(--bs-light)"></i>
                    <span>@Localizer["PocketTransfer"]</span>
                </a>
            </div>
        </nav>
    </div>
    <div id="nav-wrapper">
        <nav class="stick-bottom bg-primary col-12 col-md-4">
            <a class="nav-item active" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-fill fs-4"></i>
            </a>
            <a class="nav-item" asp-controller="Savings" asp-action="Index">
                <i class="bi bi bi-piggy-bank-fill fs-4"></i>
                <span>@Localizer["Savings"]</span>
            </a>
            <a class="nav-item" asp-controller="Outflows" asp-action="Index">
                <i class="bi bi-cash-coin fs-4"></i>
                <span>@Localizer["Expenses"]</span>
            </a>
            <div class="nav-center-slot">
                <button id="add-btn" class="btn-circle btn-tertiary">
                    <i class="bi bi-plus-lg fs-4"></i>
                </button>
            </div>
            <a class="nav-item" asp-controller="Inflows" asp-action="IndexFixedIncomes">
                <i class="bi bi bi-cash-stack fs-4"></i>
                <span>@Localizer["FixedIncomes"]</span>
            </a>
            <a class="nav-item" asp-controller="Inflows" asp-action="Index">
                <i class="bi bi-bank2 fs-4"></i>
                <span>@Localizer["Incomes"]</span>
            </a>
            <a id="more-btn" class="nav-item" id="more-btn">
                <i class="bi bi bi-list fs-4" style="color:var(--bs-light)"></i>
                <span style="color:var(--bs-light)">@Localizer["More"]</span>
            </a>
        </nav>
    </div>

    <div id="preloader"></div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; <script type="text/javascript">var d = new Date(); yr = d.getFullYear(); document.write(yr);</script> - Famnances™ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <!-- JavaScript Bundle with Popper -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.4/js/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.1/jquery-ui.min.js" integrity="sha512-MSOo1aY+3pXCOCdGAYoBZ6YGI0aragoQsg1mKKBHXCYPIWxamwOE7Drh+N5CPgGI5SA9IEKJiPjdfqWFWmZtRA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
