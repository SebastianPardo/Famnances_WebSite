<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Famnances</title>

    <!-- CSS only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/2.3.1/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/3.0.4/css/responsive.dataTables.min.css" rel="stylesheet" />


    <link rel="stylesheet" href="~/fonts/boxicons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3004437161279642" crossorigin="anonymous"></script>
</head>
<body style="background-color:var(--bs-teal);">
    <!-- Topbar Start -->
    <header>
        <div class="container-fluid topbar px-0 d-none d-lg-block">
            <div class="container px-0">
                <div class="gx-0 align-items-center" style="height: 55px;">
                    <div class="col-lg-12 text-center mb-lg-0">
                        <a asp-controller="Home" asp-action="Index" class="logo d-flex flex-wrap">
                            <img src="~/images/logos/logo.png" class="rounded mx-auto d-block" style="max-width:20%" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- Topbar End -->
    <!-- Navbar & Hero Start -->
    <div class="container-fluid sticky-top px-0">
        <div class="row">
            <div class="container px-0 ms-auto" style="max-width: 90%;">
                <nav class="navbar navbar-expand-lg bg-primary py-3 px-4">
                    <div class="col-11 col-sm">
                        <a asp-controller="Home" asp-action="Index" class="logo m-0 float-start">
                            <img id="logo-img" src="~/images/logos/no-logo.png" alt="Logo" class="rounded mx-auto" style="max-width:30%">
                        </a>
                    </div>
                    <a class="burger light me-auto float-end mt-1 site-menu-toggle js-menu-toggle d-inline-block d-lg-none"
                       type="button"
                       data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                        <span class="fa fa-bars"></span>
                    </a>
                    <div class="collapse navbar-collapse" id="navbarCollapse">
                        <div id="menu" class="navbar-nav py-0">
                            <a class="nav-item nav-link active" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Savings</a>
                                <div class="dropdown-menu m-0">
                                    <a asp-controller="Savings" asp-action="Index" class="dropdown-item">Transactions</a>
                                    <a asp-controller="Savings" asp-action="IndexPockets" class="dropdown-item">Pockets</a>
                                </div>
                            </div>
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Incomes</a>
                                <div class="dropdown-menu m-0">
                                    <a asp-controller="Inflows" asp-action="Index" class="dropdown-item">Inflow</a>
                                    <a asp-controller="Inflows" asp-action="IndexFixedIncomes" class="dropdown-item">Fixed</a>
                                    <a asp-controller="IncomeDiscounts" asp-action="Index" class="dropdown-item">Discounts</a>
                                </div>
                            </div>
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Expenses</a>
                                <div class="dropdown-menu m-0">
                                    <a asp-controller="Outflows" asp-action="Index" class="dropdown-item">Outflow</a>
                                    <a asp-controller="Outflows" asp-action="IndexFixedExpenses" class="dropdown-item">Fixed</a>
                                    <a asp-controller="Budgets" asp-action="Index" class="dropdown-item">Budgets</a>
                                </div>
                            </div>
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Profile</a>
                                <div class="dropdown-menu m-0">
                                    <a asp-controller="Users" asp-action="CreateHome" class="dropdown-item">Household</a>
                                    <a asp-controller="Users" asp-action="Details" class="dropdown-item">My Account</a>
                                    <a asp-controller="Login" asp-action="Logout" class="dropdown-item">Logout</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
    <!-- Navbar & Hero End -->
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="card">
                <div class="card-body pb-3">
                    @* <main role="main" class="pb-3"> *@
                    @RenderBody()
                    @* </main> *@
                </div>
            </div>
        </div>
    </div>

    <div id="preloader"></div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; <script type="text/javascript">var d = new Date(); yr = d.getFullYear(); document.write(yr);</script> - Famnances™ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <!-- JavaScript Bundle with Popper -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.4/js/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.1/jquery-ui.min.js" integrity="sha512-MSOo1aY+3pXCOCdGAYoBZ6YGI0aragoQsg1mKKBHXCYPIWxamwOE7Drh+N5CPgGI5SA9IEKJiPjdfqWFWmZtRA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
