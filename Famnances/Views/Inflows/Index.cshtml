@model IEnumerable<Famnances.DataCore.Entities.Inflow>

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="d-flex justify-content-between">
        <h4 class="card-header"><strong>Fixed Income</strong></h4>
        <div class="m-3">
            <a type="button" class="btn rounded-pill btn-icon btn-primary card-header" asp-controller="Inflows" asp-action="Create" formmethod="get">
                <span class="tf-icons bx bx-plus"></span>
            </a>
        </div>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Value)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TransactionDate)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @item.TransactionDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            <a asp-action="Edit" class="btn btn-secondary" asp-route-id="@item.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
