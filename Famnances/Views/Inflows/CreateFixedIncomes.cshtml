@model Famnances.Models.ViewModels.FixedIncomeViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer


@{
    ViewData["Title"] = "Create - Fixed Income";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="CreateFixedIncomes" asp-controller="Inflows" method="post">
            <div class="row">
                <div class="row">
                    <div class="col-12 col-md-12 text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" asp-for="FixedIncome.Active" class="btn-check" value="true" id="Active" autocomplete="off" />
                            <label class="btn btn-outline-primary" for="Active">@Localizer["Active"]</label>
                            <input type="radio" asp-for="FixedIncome.Active" class="btn-check" value="false" id="Inactive" autocomplete="off" checked />
                            <label class="btn btn-outline-primary" for="Inactive">@Localizer["Inactive"]</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-12 mt-2">
                        <label asp-for="FixedIncome.ShareOnHousehold" class="form-check-label"></label>
                    </div>
                    <div class="col-12 col-md-12 text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" asp-for="FixedIncome.ShareOnHousehold" class="btn-check" value="true" id="Share" autocomplete="off" />
                            <label class="btn btn-outline-primary" for="Share">@Localizer["Yes"]</label>
                            <input type="radio" asp-for="FixedIncome.ShareOnHousehold" class="btn-check" value="false" id="NoShare" autocomplete="off" checked />
                            <label class="btn btn-outline-primary" for="NoShare">@Localizer["No"]</label>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="FixedIncome.Description" class="control-label text-start"></label>
                    <input asp-for="FixedIncome.Description" class="form-control" />
                    <span asp-validation-for="FixedIncome.Description" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="FixedIncome.Value" class="control-label text-start"></label>
                    <input asp-for="FixedIncome.Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="FixedIncome.Value" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="FixedIncome.ValuePeriodId" class="control-label text-start"></label>
                    <select asp-for="FixedIncome.ValuePeriodId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true">
                        <option selected disabled hidden>@Localizer["Select"]</option>
                    </select>
                    <span asp-validation-for="FixedIncome.PayablePeriod" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="FixedIncome.PayablePeriodId" class="control-label text-start"></label>
                    <select asp-for="FixedIncome.PayablePeriodId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true">
                        <option selected disabled hidden>@Localizer["Select"]</option>
                    </select>
                    <span asp-validation-for="FixedIncome.PayablePeriod" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label class="control-label text-start">@Localizer["Deductions"]</label>
                    <select asp-for="SelectedIncomeDiscountIds" class="select2 form-control" asp-items=@ViewBag.Discounts multiple placeholder="@Localizer["Select"]"></select>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="FixedIncome.FirstPayDate" class="control-label text-start"></label>
                    <input asp-for="FixedIncome.FirstPayDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FixedIncome.FirstPayDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-primary w-100" value="@Localizer["Save"]" />
            </div>
        </form>
    </div>
</div>