@model Famnances.DataCore.ServicesModels.IncomeTransactionModel

@{
    ViewData["Title"] = "Create";
}

<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Create</strong></h2>
        <h5 class="card-subtitle">Inflow</h5>
    </div>
</div>
<hr />
<form asp-action="Create">
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-3">
            <label asp-for="Income.Description" class="control-label"></label>
            <input asp-for="Income.Description" class="form-control" />
            <span asp-validation-for="Income.Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Income.Value" class="control-label"></label>
            <input asp-for="Income.Value" class="form-control" type="number" />
            <span asp-validation-for="Income.Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Income.TransactionDate" class="control-label"></label>
            <input asp-for="Income.TransactionDate" class="form-control" type="date" />
            <span asp-validation-for="Income.TransactionDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="control-label text-start">Discount</label>
            <select asp-for="SelectedIncomeDiscountIds" class="select2 form-control" asp-items=@ViewBag.Discounts multiple placeholder="Select"></select>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
