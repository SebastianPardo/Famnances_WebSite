@model Famnances.DataCore.Entities.FixedIncome

@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Edit</strong></h2>
        <h5 class="card-subtitle">Fixed Income</h5>
    </div>
</div>
<hr />

<form asp-action="FixedIncomeUpdate" asp-controller="Inflows" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col col-md-3 col-sm-6">
            <div class="form-check form-check-inline" style="margin-top: 2rem;">
                <label class="form-check-label" for="flexCheckDefault">
                    Active
                </label>
                <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" checked />
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="Description" class="control-label text-start"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Value" class="control-label text-start"></label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FirstPayDate" class="control-label text-start"></label>
            <input asp-for="FirstPayDate" class="form-control" type="date" />
            <span asp-validation-for="FirstPayDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PayablePeriodId" class="control-label text-start"></label>
            <select asp-for="PayablePeriodId" class="form-select" asp-items="@ViewBag.Periods" data_live_search="true">
                <option disabled selected> Select </option>
            </select>
            <span asp-validation-for="PayablePeriod" class="text-danger"></span>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("DeleteFixedIncome")" formmethod="post" />
        </div>
    </div>
</form>