@model Famnances.DataCore.ServicesModels.IncomeTransactionModel

@{
    ViewData["Title"] = "Edit - Inflow";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">Edit @Model.Income.Description <strong>Inflow</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="Edit">
            <div class="row">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Income.Id" />
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Income.Description" class="control-label"></label>
                    <input asp-for="Income.Description" class="form-control" />
                    <span asp-validation-for="Income.Description" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Income.Value" class="control-label"></label>
                    <input asp-for="Income.Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Income.Value" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Income.TransactionDate" class="control-label"></label>
                    <input asp-for="Income.TransactionDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Income.TransactionDate" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label class="control-label text-start">Discount</label>
                    <select asp-for="SelectedIncomeDiscountIds" class="select2 form-control" asp-items=@ViewBag.Discounts multiple placeholder="Select"></select>
                </div>
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-primary form-control w-100" value="Save" />
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-danger form-control w-100" value="Delete" formaction="@Url.Action("Delete", new { id = Model.Income.Id })" formmethod="post" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
