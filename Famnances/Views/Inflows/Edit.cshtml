@model Famnances.DataCore.Entities.Inflow

@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Edit</strong></h2>
        <h5 class="card-subtitle">Inflowt</h5>
    </div>
</div>
<hr />
<form asp-action="Edit">
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="col-md-3">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Value" class="control-label"></label>
            <input asp-for="Value" class="form-control" type="number" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="TransactionDate" class="control-label"></label>
            <input asp-for="TransactionDate" class="form-control" type="date" />
            <span asp-validation-for="TransactionDate" class="text-danger"></span>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("Delete")" formmethod="post" />
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
