@model Famnances.DataCore.Entities.Inflow

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Inflow</h4>
<hr />
<div class="row">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="col-md-3">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Value" class="control-label"></label>
            <input asp-for="Value" class="form-control" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DateTimeStamp" class="control-label"></label>
            <input asp-for="DateTimeStamp" class="form-control" disabled />
            <span asp-validation-for="DateTimeStamp" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <input type="submit" value="Delete" class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id" />
        </div>
    </form>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
