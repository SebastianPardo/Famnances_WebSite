@model IEnumerable<Famnances.DataCore.Entities.FixedIncome>

@using System.Globalization   
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer


@{
    ViewData["Title"] = "Index - Fixed Income";
    Layout = "~/Views/Shared/_IndexLayout.cshtml";
}

<div class="d-flex justify-content-between">
    <div class="col-2 ms-3">
        <a class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Inflows" asp-action="CreateFixedIncomes">
            <i class="bi bi-plus-lg fs-4"></i>
        </a>
    </div>
    <div class="col col-9 text-body-primary text-end p-3">
        <h2 class="card-title"><strong>@Localizer["Title"]</strong></h2>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Active)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th>@Html.DisplayNameFor(model => model.Value)</th>
                    <th>@Html.DisplayNameFor(model => model.PayablePeriod)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Active)
                            {
                                <span class="badge bg-success">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@Localizer["Inactive"]</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @switch (CultureInfo.CurrentCulture.Name)
                            {
                                case "ES":
                                case "es-CO":
                                    <p>@item.PayablePeriod.NameES</p>
                                    break;
                                case "EN":
                                case "en-CA":
                                    <p>@item.PayablePeriod.NameEN</p>
                                    break;
                                case "FR":
                                case "fr-CA":
                                    <p>@item.PayablePeriod.NameFR</p>
                                    break;
                            }
                        </td>                        
                        <td>
                            <div class="row">
                                <div class="col-auto">
                                    <a asp-action="EditFixedIncomes" class="btn btn-secondary" asp-route-id="@item.Id">@Localizer["Edit"]</a>
                                </div>
                                <div class="col-auto">
                                    <form asp-action="ReceiveFixedIncome" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-tertiary">@Localizer["Deposit"]</button>
                                    </form>
                                </div>
                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>