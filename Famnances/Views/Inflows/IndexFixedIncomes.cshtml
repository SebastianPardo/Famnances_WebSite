@model IEnumerable<Famnances.DataCore.Entities.FixedIncome>

<div class="card">
    <div class="d-flex justify-content-between">
        <h4 class="card-header"><strong>Fixed Income</strong></h4>
        <div class="m-3">
            <a type="button" class="btn rounded-pill btn-icon btn-primary card-header" asp-controller="Inflows" asp-action="CreateFixedIncome" formmethod="get">
                <span class="tf-icons bx bx-plus"></span>
            </a>
        </div>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Active</th>
                    <th>Description</th>
                    <th>Value</th>
                    <th>Period</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if(item.Active)
                            {
                                <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" checked disabled/>
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" disabled />
                            }
                        </td>
                        <th>
                            @Html.DisplayFor(modelItem => item.Description)
                        </th>
                        <td>
                            $ @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PayablePeriod.Name)
                        </td>
                        <td>
                            @Html.ActionLink("Details", "FixedIncomeDetails", new { id = item.Id }, new { @class = "btn btn-block btn-secondary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>