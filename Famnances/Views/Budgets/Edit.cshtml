@model Famnances.DataCore.Entities.ExpensesBudget
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-controller="Budgets" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-3">
                    <label asp-for="Name" class="control-label text-start"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Value" class="control-label text-start"></label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-2">
                    <label class="control-label">&nbsp;</label>
                    <input type="submit" class="btn btn-primary form-control" value="Save" />
                </div>
            </div>
        </form>
    </div>
</div>