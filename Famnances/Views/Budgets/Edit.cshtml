@model Famnances.DataCore.Entities.ExpensesBudget
@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Edit</strong></h2>
        <h5 class="card-subtitle">Budgets</h5>
    </div>
</div>
<hr />
<form asp-action="Edit" asp-controller="Budgets" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-2 form-check">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="ShareOnHousehold" /> @Html.DisplayNameFor(model => model.ShareOnHousehold)
            </label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="Name" class="control-label text-start"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Value" class="control-label text-start"></label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("Delete")" formmethod="post" />
        </div>
    </div>
</form>
