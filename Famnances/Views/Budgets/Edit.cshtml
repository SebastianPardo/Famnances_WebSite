@model Famnances.DataCore.Entities.ExpensesBudget
@{
    ViewData["Title"] = "Edit - Budget";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">@Model.Name <strong>Budget</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="Edit" asp-controller="Budgets" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BudgetTypeId" />
            <div class="row">
                <div class="col-12 col-md-12">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareOnHousehold" /> @Html.DisplayNameFor(model => model.ShareOnHousehold)
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Name" class="control-label text-start"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Value" class="control-label text-start"></label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-primary form-control w-100" value="Save" />
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-danger form-control w-100" value="Delete" formaction="@Url.Action("Delete")" formmethod="post" />
            </div>
        </form>
    </div>
</div>

