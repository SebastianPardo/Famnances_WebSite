@model IEnumerable<Famnances.DataCore.Entities.ExpensesBudget>
@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between">
    <div class="ms-3 mb-3 mt-1">
        <a type="button" class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Budgets" asp-action="Create" formmethod="get">
            <span class="tf-icons bx bx-plus"></span>
        </a>
    </div>
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Index</strong></h2>
        <h5 class="card-subtitle">Budgets</h5>
    </div>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Value</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th>
                    @Html.DisplayFor(modelItem => item.Name)
                </th>
                <td>
                    $ @Html.DisplayFor(modelItem => item.Value)
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-secondary" asp-route-id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>