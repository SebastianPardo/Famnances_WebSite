@model Famnances.DataCore.Entities.ExpensesBudget

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Details - Budget";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">@Model.Name <strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-12 mt-2 text-center">
                @if (Model.Active)
                {
                    <span class="badge bg-success">@Localizer["Active"]</span>
                }
                else
                {
                    <span class="badge bg-danger">@Localizer["Inactive"]</span>
                }
            </div>
            <div class="col-12 col-md-12 mt-2">
                <label class="form-check-label">@Html.DisplayNameFor(model => model.ShareOnHousehold)</label>
                @if (Model.ShareOnHousehold)
                {
                    <span class="badge bg-success">@Localizer["Yes"]</span>
                }
                else
                {
                    <span class="badge bg-danger">@Localizer["No"]</span>
                }
            </div>
            <div class="col-12 col-md-12 mt-2">
                <label asp-for="Value" class="control-label text-start"></label>
                <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" readonly />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <a asp-action="Edit" class="btn btn-secondary w-100" asp-route-id="@Model.Id">@Localizer["Edit"]</a>
            </div>
        </div>
        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Outflow.First().Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Outflow.First().Value)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Outflow.First().TransactionDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Outflow.First().DateTimeStamp)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Outflow)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Value)
                            </td>
                            <td>
                                @item.TransactionDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                @item.DateTimeStamp.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <a asp-controller="Outflows" asp-action="Edit" class="btn btn-secondary" asp-route-id="@item.Id">@Localizer["Edit"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>