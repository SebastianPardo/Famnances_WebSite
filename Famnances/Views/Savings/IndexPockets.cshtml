@model IEnumerable<Famnances.DataCore.Entities.SavingsPocket>

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="d-flex justify-content-between">
        <h4 class="card-header"><strong>Saving Pockets</strong></h4>
        <div class="m-3">
            <a type="button" class="btn rounded-pill btn-icon btn-primary card-header" asp-controller="Savings" asp-action="CreatePockets" formmethod="get">
                <span class="tf-icons bx bx-plus"></span>
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Total)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ChallengeValue)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Total)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ChallengeValue)
                        </td>
                        <td>
                            <a asp-action="EditPockets" class="btn btn-secondary" asp-route-id="@item.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
