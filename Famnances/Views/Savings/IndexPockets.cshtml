@model IEnumerable<Famnances.DataCore.Entities.SavingsPocket>

@{
    ViewData["Title"] = "Index - Pocket";
}

<div class="d-flex justify-content-between">
    <div class="ms-3 mb-3 mt-1">
        <a type="button" class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Savings" asp-action="CreatePockets" formmethod="get">
            <span class="tf-icons bx bx-plus"></span>
        </a>
    </div>
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title"><strong>Pockets</strong></h3>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Total)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChallengeValue)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Total)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChallengeValue)
                </td>
                <td>
                    <a asp-action="DetailsPocket" class="btn btn-secondary" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
