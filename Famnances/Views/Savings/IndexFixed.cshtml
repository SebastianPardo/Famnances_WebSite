@model IEnumerable<Famnances.DataCore.Entities.FixedSaving>

@{
    ViewData["Title"] = "Index - Fixed Savings";
}

<div class="d-flex justify-content-between">
    <div class="ms-3 mb-3 mt-1">
        <a type="button" class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Savings" asp-action=CreateFixed" formmethod="get">
            <span class="tf-icons bx bx-plus"></span>
        </a>
    </div>
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title"><strong>Recurring Savings</strong></h3>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Value)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SavingSourceId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SavingsPocketId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PeriodicityId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Value)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SavingSource.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SavingsPocket.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Periodicity.Name)
                </td>
                <td>
                   @item.EndDate.Value.ToString("dd MMM yyyy")
                </td>
                <td>
                    <a asp-action="EditFixed" class="btn btn-secondary" asp-route-id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
