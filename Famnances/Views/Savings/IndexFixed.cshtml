@model IEnumerable<Famnances.DataCore.Entities.FixedSaving>

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using System.Globalization

@{
    ViewData["Title"] = "Index - Fixed Savings";
}

<div class="d-flex justify-content-between">
    <div class="col-2 ms-3">
        <a class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Savings" asp-action="CreateFixed">
            <i class="bi bi-plus-lg fs-4"></i>
        </a>
    </div>
    <div class="col col-9 text-body-primary text-end p-3">
        <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Value)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SavingSourceId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SavingsPocketId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PeriodicityId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.EndDate)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @switch (CultureInfo.CurrentCulture.Name)
                            {
                                case "ES":
                                case "es-CO":
                                    <p>@item.SavingSource.NameEs</p>
                                    break;
                                case "EN":
                                case "en-CA":
                                    <p>@item.SavingSource.NameEn</p>
                                    break;
                                case "FR":
                                case "fr-CA":
                                    <p>@item.SavingSource.NameFr</p>
                                    break;
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SavingsPocket.Name)
                        </td>
                        <td>
                            @switch (CultureInfo.CurrentCulture.Name)
                            {
                                case "ES":
                                case "es-CO":
                                    <p>@item.Periodicity.NameES</p>
                                    break;
                                case "EN":
                                case "en-CA":
                                    <p>@item.Periodicity.NameEN</p>
                                    break;
                                case "FR":
                                case "fr-CA":
                                    <p>@item.Periodicity.NameFR</p>
                                    break;
                            }
                        </td>
                        <td>
                            @item.EndDate.Value.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            <a asp-action="EditFixed" class="btn btn-sm btn-secondary w-100" asp-route-id="@item.Id">@Localizer["Edit"]</a>
                            <a asp-action="TransferFixed" asp-route-id="@item.Id" method="post" type="submit" class="btn btn-sm btn-tertiary w-100">@Localizer["Transfer"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
