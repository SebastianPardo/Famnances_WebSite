@model Famnances.Models.ViewModels.SavingTransactionView

@{
    ViewData["Title"] = "Create";
}
<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Create</strong></h2>
        <h5 class="card-subtitle">Saving Transaction</h5>
    </div>
</div>
<hr />
<div class="row">
    <ul class="nav nav-tabs justify-content-center" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="expense-tab" data-bs-toggle="tab" data-bs-target="#expense-tab-pane" type="button" role="tab" aria-controls="expense-tab-pane" aria-selected="true">Expense</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="add-tab" data-bs-toggle="tab" data-bs-target="#add-tab-pane" type="button" role="tab" aria-controls="add-tab-pane" aria-selected="false">Add</button>
        </li>
    </ul>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="expense-tab-pane" role="tabpanel" aria-labelledby="expense-tab" tabindex="0">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <input type="hidden" asp-for="SavingTransaction.IsExpense" value="True" />
                    <div class="col-md-2 form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="SavingTransaction.IsEmergency" /> @Html.DisplayNameFor(model => model.SavingTransaction.IsEmergency)
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.SavingsPocketId" class="control-label"></label>
                        <select asp-for="SavingTransaction.SavingsPocketId" class="form-control" asp-items="ViewBag.SavingsPocketId"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.Description" class="control-label"></label>
                        <input asp-for="SavingTransaction.Description" class="form-control" />
                        <span asp-validation-for="SavingTransaction.Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.Value" class="control-label"></label>
                        <input asp-for="SavingTransaction.Value" class="form-control" />
                        <span asp-validation-for="SavingTransaction.Value" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.TransactionDate" class="control-label"></label>
                        <input asp-for="SavingTransaction.TransactionDate" class="form-control" type="date" />
                        <span asp-validation-for="SavingTransaction.TransactionDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-md-2">
                        <label class="control-label">&nbsp;</label>
                        <input type="submit" class="btn btn-primary form-control" value="Save" />
                    </div>
                </div>
            </form>
        </div>
        <div class="tab-pane fade" id="add-tab-pane" role="tabpanel" aria-labelledby="add-tab" tabindex="0">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="SavingTransaction.IsExpense" value="False" />
                <div class="row">
                    <div class="col-md-3">
                        <label asp-for="SavingSource" class="control-label"></label>
                        <select asp-for="SavingSource" class="form-control" asp-items="ViewBag.SavingsSources"></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.SavingsPocketId" class="control-label"></label>
                        <select asp-for="SavingTransaction.SavingsPocketId" class="form-control" asp-items="ViewBag.SavingsPocketId"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.Description" class="control-label"></label>
                        <input asp-for="SavingTransaction.Description" class="form-control" />
                        <span asp-validation-for="SavingTransaction.Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.Value" class="control-label"></label>
                        <input asp-for="SavingTransaction.Value" class="form-control" />
                        <span asp-validation-for="SavingTransaction.Value" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SavingTransaction.TransactionDate" class="control-label"></label>
                        <input asp-for="SavingTransaction.TransactionDate" class="form-control" type="date" />
                        <span asp-validation-for="SavingTransaction.TransactionDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-md-2">
                        <label class="control-label">&nbsp;</label>
                        <input type="submit" class="btn btn-primary form-control" value="Save" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
