@model Famnances.DataCore.Entities.FixedSaving

@{
    ViewData["Title"] = "Edit - Pocket";
}

<div class="d-flex justify-content-end">
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title">Edit @Model.Value <strong>Recurring saving</strong></h3>
    </div>
</div>
<hr />
<form asp-action="EditFixed">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-2">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
            </label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="Value" class="control-label"></label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PeriodicityId" class="control-label"></label>
            <select asp-for="PeriodicityId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="SavingsPocketId" class="control-label"></label>
            <select asp-for="SavingsPocketId" class="form-control select2" asp-items="@ViewBag.SavingsPocketId" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="EndDate" class="control-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="SavingSourceId" class="control-label"></label>
            <select asp-for="SavingSourceId" class="form-control select2" asp-items="@ViewBag.SavingSourceId" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-8 col-md-2">
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-4 col-md-2">
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("DeletePockets")" formmethod="post" />
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
