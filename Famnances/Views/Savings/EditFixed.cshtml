@model Famnances.DataCore.Entities.FixedSaving

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Edit - Pocket";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="EditFixed">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-12 col-md-12 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" asp-for="IsActive" class="btn-check" value="true" id="Active" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="Active">@Localizer["Active"]</label>
                        <input type="radio" asp-for="IsActive" class="btn-check" value="false" id="Inactive" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="Inactive">@Localizer["Inactive"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="SavingSourceId" class="control-label"></label>
                    <select asp-for="SavingSourceId" class="form-control select2" asp-items="@ViewBag.SavingSources" data-live-search="true">
                        <option selected disabled hidden>@Localizer["Select"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Value" class="control-label"></label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="SavingsPocketId" class="control-label"></label>
                    <select asp-for="SavingsPocketId" class="form-control select2" asp-items="@ViewBag.SavingsPockets" data-live-search="true">
                        <option selected disabled hidden>@Localizer["Select"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="PeriodicityId" class="control-label"></label>
                    <select asp-for="PeriodicityId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true">
                        <option selected disabled hidden>@Localizer["Select"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="EndDate" class="control-label"></label>
                    <input asp-for="EndDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 mt-3">
                <input type="submit" class="btn btn-primary form-control w-100" value="@Localizer["Save"]" />
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-danger form-control w-100" value="@Localizer["Delete"]" formaction="@Url.Action("DeleteFixed")" formmethod="post" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
