@model IEnumerable<Famnances.DataCore.Entities.SavingRecord>

@{
    ViewData["Title"] = "Index - Saving";
}

<div class="d-flex justify-content-between">
    <div class="ms-3 mb-3 mt-1">
        <a type="button" class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Savings" asp-action="Create" formmethod="get">
            <span class="tf-icons bx bx-plus"></span>
        </a>
    </div>
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title"><strong>Savings</strong></h3>
    </div>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Value)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TransactionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateTimeStamp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SavingsPocket)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsExpense)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsEmergency)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Value)
                </td>
                <td>
                    @item.TransactionDate.ToString("dd MMM yyyy")
                </td>
                <td>
                    @item.DateTimeStamp.ToString("dd MMM yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SavingsPocket.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsExpense)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsEmergency)
                </td>
                <td>
                    <a asp-action="Edit" class=" btn btn-secondary" asp-route-id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>