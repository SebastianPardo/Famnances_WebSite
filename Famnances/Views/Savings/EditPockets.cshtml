@model Famnances.DataCore.Entities.SavingsPocket

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Edit - Pocket";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">@Model.Name <strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="EditPockets">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-12 col-md-12 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" asp-for="IsActive" class="btn-check" value="true" id="Active" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="Active">@Localizer["Active"]</label>
                        <input type="radio" asp-for="IsActive" class="btn-check" value="false" id="Inactive" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="Inactive">@Localizer["Inactive"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="ShareOnHousehold" class="form-check-label"></label>
                </div>
                <div class="col-12 col-md-12 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" asp-for="ShareOnHousehold" class="btn-check" value="true" id="Share" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="Share">@Localizer["Yes"]</label>
                        <input type="radio" asp-for="ShareOnHousehold" class="btn-check" value="false" id="NoShare" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="NoShare">@Localizer["No"]</label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="ChallengeValue" class="control-label"></label>
                    <input asp-for="ChallengeValue" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="ChallengeValue" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Total" class="control-label"></label>
                    <input asp-for="Total" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Total" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 mt-3">
                <input type="submit" class="btn btn-primary form-control w-100" value="@Localizer["Save"]" />
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-danger form-control w-100" value="@Localizer["Delete"]" formaction="@Url.Action("DeletePockets")" formmethod="post" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
