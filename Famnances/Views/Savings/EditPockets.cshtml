@model Famnances.DataCore.Entities.SavingsPocket

@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Edit</strong></h2>
        <h5 class="card-subtitle">Saving Pocket</h5>
    </div>
</div>
<hr />
<form asp-action="EditPockets">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-2 form-check">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
            </label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ChallengeValue" class="control-label"></label>
            <input asp-for="ChallengeValue" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="ChallengeValue" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Total" class="control-label"></label>
            <input asp-for="Total" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="Total" class="text-danger"></span>
        </div>

    </div>

    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("DeletePockets")" formmethod="post" />
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
