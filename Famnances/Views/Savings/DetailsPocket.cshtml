@model Famnances.DataCore.Entities.SavingsPocket

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Details - Pocket";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">@Model.Name <strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-12 mt-2 text-center">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">@Localizer["Active"]</span>
                }
                else
                {
                    <span class="badge bg-danger">@Localizer["Inactive"]</span>
                }
            </div>
            <div class="col-12 col-md-12 mt-2">
                <label class="form-check-label">@Html.DisplayNameFor(model => model.ShareOnHousehold)</label>
                @if (Model.ShareOnHousehold)
                {
                    <span class="badge bg-success">@Localizer["Yes"]</span>
                }
                else
                {
                    <span class="badge bg-danger">@Localizer["No"]</span>
                }
            </div>
            <div class="col-12 col-md-12 mt-2">
                <label asp-for="ChallengeValue" class="control-label"></label>
                @if (Model.ChallengeValue > 0)
                {
                    <input asp-for="ChallengeValue" class="form-control" type="number" step="0.01" placeholder="00.00" />
                }
                else
                {
                    <span class="badge bg-warning">@Localizer["FreePocket"]</span>
                }
                <span asp-validation-for="ChallengeValue" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-12 mt-2">
                <label asp-for="Total" class="control-label"></label>
                <input asp-for="Total" class="form-control" type="number" step="0.01" placeholder="00.00" readonly />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <a asp-action="EditPockets" class="btn btn-secondary w-100" asp-route-id="@Model.Id">@Localizer["Edit"]</a>
            </div>
        </div>

        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.SavingsRecords.First().Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SavingsRecords.First().Value)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SavingsRecords.First().TransactionDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SavingsRecords.First().IsExpense)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SavingsRecords.First().IsEmergency)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SavingsRecords)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Value)
                            </td>
                            <td>
                                @item.TransactionDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                @if (item.IsExpense)
                                {
                                    <span class="badge bg-danger">@Localizer["Expense"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@Localizer["Deposit"]</span>
                                }
                            </td>
                            <td>
                                @if (item.IsEmergency)
                                {
                                    <span class="badge bg-warning">@Localizer["Yes"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Localizer["No"]</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" class=" btn btn-secondary" asp-route-id="@item.Id">@Localizer["Edit"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
