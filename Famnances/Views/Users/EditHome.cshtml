@model Famnances.DataCore.Entities.Home

@{
    ViewData["Title"] = "Edit - Househould";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">Edit <strong>Household</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="EditHome" asp-controller="Users">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-12 col-md-12 mt-2 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareIncomes" /> @Html.DisplayNameFor(model => model.ShareIncomes)
                    </label>
                </div>
                <div class="col-12 col-md-12 mt-2 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareExpenses" /> @Html.DisplayNameFor(model => model.ShareExpenses)
                    </label>
                </div>
                <div class="col-12 col-md-12 mt-2 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareSavings" /> @Html.DisplayNameFor(model => model.ShareSavings)
                    </label>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-primary form-control w-100" value="Save" />
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-tertiary form-control w-100" value="Invite" formaction="@Url.Action("Invitations")" formmethod="get" />
            </div>
            <div class="col-12 col-md-12 mt-2">
                <input type="submit" class="btn btn-danger form-control w-100" value="Delete" formaction="@Url.Action("DeleteHome")" formmethod="post" />
            </div>
        </form>
    </div>
</div>