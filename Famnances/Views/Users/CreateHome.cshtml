@model Famnances.DataCore.Entities.Home

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Create - Household";
}
<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="CreateHome" asp-controller="Users">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="ShareIncomes" class="form-check-label"></label>
                </div>
                <div class="col-12 col-md-12 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" asp-for="ShareIncomes" class="btn-check" value="true" id="ShareIncomes" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="ShareIncomes">@Localizer["Yes"]</label>
                        <input type="radio" asp-for="ShareIncomes" class="btn-check" value="false" id="NoShareIncomes" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="NoShareIncomes">@Localizer["No"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="ShareExpenses" class="form-check-label"></label>
                </div>
                <div class="col-12 col-md-12 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" asp-for="ShareExpenses" class="btn-check" value="true" id="ShareExpenses" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="ShareExpenses">@Localizer["Yes"]</label>
                        <input type="radio" asp-for="ShareExpenses" class="btn-check" value="false" id="NoShareExpenses" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="NoShareExpenses">@Localizer["No"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="ShareSavings" class="form-check-label"></label>
                </div>
                <div class="col-12 col-md-12 text-center">
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" asp-for="ShareSavings" class="btn-check" value="true" id="ShareSavings" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="ShareSavings">@Localizer["Yes"]</label>
                        <input type="radio" asp-for="ShareSavings" class="btn-check" value="false" id="NoShareSavings" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="NoShareSavings">@Localizer["No"]</label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-primary w-100" value="@Localizer["Save"]" />
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-secondary form-control" value="@Localizer["RequestJoin"]" formaction="@Url.Action("Invitations")" formmethod="get" />
            </div>
        </form>
    </div>
</div>

