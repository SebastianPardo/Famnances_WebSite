@model Famnances.DataCore.Entities.Home
@{
    ViewData["Title"] = "Create - Household";
}
<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">Create <strong>Household</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="CreateHome" asp-controller="Users">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareIncomes" /> @Html.DisplayNameFor(model => model.ShareIncomes)
                    </label>
                </div>
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareExpenses" /> @Html.DisplayNameFor(model => model.ShareExpenses)
                    </label>
                </div>
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="ShareSavings" /> @Html.DisplayNameFor(model => model.ShareSavings)
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-primary w-100" value="Save" />
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-secondary form-control" value="Request join" formaction="@Url.Action("Invitations")" formmethod="get" />
            </div>
        </form>
    </div>
</div>

