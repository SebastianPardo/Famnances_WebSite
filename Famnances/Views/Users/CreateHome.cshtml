@model Famnances.DataCore.Entities.Home
@{
    ViewData["Title"] = "CreateHome";
}
<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Create</strong></h2>
        <h5 class="card-subtitle">Home</h5>
    </div>
</div>
<hr />
<form asp-action="CreateHome" asp-controller="Users">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-2 form-check">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="ShareIncomes" /> @Html.DisplayNameFor(model => model.ShareIncomes)
            </label>
        </div>
        <div class="col-md-2 form-check">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="ShareExpenses" /> @Html.DisplayNameFor(model => model.ShareExpenses)
            </label>
        </div>
        <div class="col-md-2 form-check">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="ShareSavings" /> @Html.DisplayNameFor(model => model.ShareSavings)
            </label>
        </div>
        <div class="col-md-3">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-secondary form-control" value="Request join" formaction="@Url.Action("Invitations")" formmethod="get" />
        </div>
    </div>
</form>

