@model Famnances.DataCore.Entities.User

<div class="d-flex justify-content-end">
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Details</strong></h2>
        <h5 class="card-subtitle">User</h5>
    </div>
</div>
<hr />
<form asp-action="Details" asp-controller="Users" method="post">
    <div class="row">
        <div class="col-md-3">
            <label asp-for="FirstName" class="control-label text-start"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="LastName" class="control-label text-start"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LegalName" class="control-label text-start"></label>
            <input asp-for="LegalName" class="form-control" readonly />
            <span asp-validation-for="LegalName" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label class="control-label text-start">Country</label>
            <select id="Country" class="form-select" asp-items="@ViewBag.Countries" data-live-search="true">
                <option disabled selected> Select </option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="control-label text-start">Province</label>
            <select id="Province" class="form-select" data-live-search="true" disabled>
                <option disabled selected> Select </option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="CityId" class="control-label text-start"></label>
            <select asp-for="CityId" class="form-select" data_live_search="true" disabled>
                <option disabled selected> Select </option>
            </select>
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PostalCode" class="control-label text-start"></label>
            <input asp-for="PostalCode" class="form-control" />
            <span asp-validation-for="PostalCode" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label asp-for="Address" class="control-label text-start"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="AddressComplement" class="control-label text-start"></label>
            <input asp-for="AddressComplement" class="form-control" />
            <span asp-validation-for="AddressComplement" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PhoneNumber" class="control-label text-start"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="TotalBudget" class="control-label text-start"></label>
            <input asp-for="TotalBudget" class="form-control" />
            <span asp-validation-for="TotalBudget" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <label asp-for="TotalSavings" class="control-label text-start"></label>
            <input asp-for="TotalSavings" class="form-control" />
            <span asp-validation-for="TotalSavings" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="BudgetByPeriod" class="control-label text-start"></label>
            <input asp-for="BudgetByPeriod" class="form-control" />
            <span asp-validation-for="BudgetByPeriod" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PeriodId" class="control-label text-start"></label>
            <select asp-for="PeriodId" asp-items="@ViewBag.Periods" class="form-select no-search">
                <option disabled selected> Select </option>
            </select>
            <span asp-validation-for="Period" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PeriodStartsMonthsDay" class="control-label text-start"></label>
            <input asp-for="PeriodStartsMonthsDay" class="form-control" />
            <span asp-validation-for="PeriodStartsMonthsDay" class="text-danger"></span>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-2">
            <label class="control-label">&nbsp;</label>
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/Users/Create.js"></script>
}