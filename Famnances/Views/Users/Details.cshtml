@model Famnances.DataCore.Entities.User
@{
    ViewData["Title"] = "Edit - User";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}
<div class="card minicard">
    <div class="card-body p-3 pt-4">
        <div class="col d-flex">
            <label asp-for="@Model.BudgetByPeriod" class="mb-1 d-block h6 fw-semibold"></label>
        </div>
        <div class="col d-flex">
            <span class="mb-0 d-block h1 fw-semibold">$@Model.BudgetByPeriod</span>
        </div>
        <div class="col d-flex">
            <span class="mb-0 d-block h4 fw-semibold text-primary">@Model.Period.NameES</span>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body p-3 pt-4">
        <div class="col d-flex">
            <label asp-for="@Model.TotalBudget" class="mb-1 d-block h6 fw-semibold"></label>
        </div>
        <div class="col d-flex">
            <span class="mb-0 d-block h1 fw-semibold">$@Model.TotalBudget</span>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body p-3 pt-4">
        <div class="col d-flex">
            <label asp-for="@Model.TotalSavings" class="mb-1 d-block h6 fw-semibold"></label>
        </div>
        <div class="col d-flex">
            <span class="mb-0 d-block h1 fw-semibold">$@Model.TotalSavings</span>
        </div>
    </div>
</div>

<div class="card minicard">
    <div class="card-body">
        <form asp-action="Details" asp-controller="Users" method="post">
            <div class="row">
                <div class="col-md-12">
                    <label asp-for="LegalName" class="control-label text-start"></label>
                    <input asp-for="LegalName" class="form-control" readonly />
                    <span asp-validation-for="LegalName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FirstName" class="control-label text-start"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="control-label text-start"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="Address" class="control-label text-start"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="AddressComplement" class="control-label text-start"></label>
                    <input asp-for="AddressComplement" class="form-control" />
                    <span asp-validation-for="AddressComplement" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="control-label text-start">Country</label>
                    <select id="Country" class="form-control select2" asp-items="@ViewBag.Countries" data-live-search="true">
                        <option selected disabled hidden>Select</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="control-label text-start">Province</label>
                    <select id="Province" class="form-control select2" data-live-search="true">
                        <option selected disabled hidden>Select</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="CityId" class="control-label text-start"></label>
                    <select asp-for="CityId" class="form-control select2" data-live-search="true">
                        <option selected disabled hidden>Select</option>
                    </select>
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PostalCode" class="control-label text-start"></label>
                    <input asp-for="PostalCode" class="form-control" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>                
                
                <div class="col-md-9">
                    <label asp-for="PhoneNumber" class="control-label text-start"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="row justify-content-center align-items-center mt-3">
                <div class="col-12 text-center">
                    <button class="btn btn-primary w-100" type="submit">Save</button>
                </div>
            </div>
            <div class="row justify-content-center align-items-center mt-2">
                <div class="col-12 text-center">
                    <button class="btn btn-danger w-100" asp-action="SavePocket">Re do the introduction</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Users/Create.js"></script>
}