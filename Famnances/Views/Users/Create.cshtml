@model Famnances.Models.ViewModels.NewUserViewModel

@using Famnances.Helpers;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewBag.Title = "New user";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}


<h1 class="h3 text-center mb-2">@Localizer["Title"] </h1>
<p class="text-center mt-3">
    @Localizer["Subtitle"]
</p>
<form asp-action="Create" asp-controller="Users" method="post">
    <div class="row">
        <div class="col-md-12 mt-2">
            <label asp-for="Email" class="control-label text-start"></label>
            <input asp-for="Email" class="form-control" value="@TempData[Constants.EMAIL]" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-12 mt-2">
            <label asp-for="FirstName" class="control-label text-start"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-12 mt-2">
            <label asp-for="LastName" class="control-label text-start"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-12 mt-2">
            <label asp-for="Password" class="control-label text-start"></label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="col-md-12 mt-2">
            <label asp-for="ConfirmPassword" class="control-label text-start"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="col-12 text-center mt-3">
            <button class="btn btn-primary w-100">@Localizer["Add"]</button>
        </div>
    </div>
</form>