@model Famnances.Models.ViewModels.Introduction.BudgetViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@using Famnances.Helpers
@inject IViewLocalizer Localizer

@{
    ViewBag.Title = "Introduction";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@if (TempData[Constants.ERROR] != null)
{
    <div class="row">
        <div class="alert alert-danger alert-dismissible d-flex align-items-center" role="alert">
            <div class="avatar flex-shrink-0 me-2">
                <i class="bi bi-exclamation-circle fs-4" style="color:var(--bs-danger)"></i>
            </div>
            <div>@TempData[Constants.ERROR]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<form asp-action="AddBudget">
    <h1 class="h3 text-center mb-2">@Localizer["Tittle"] </h1>
    <p class="text-center mt-3">
        @Localizer["Subtittle"]
    </p>
    <div class="row">
        <div class="col-12 mt-2">
            <label asp-for="Budget.Name" class="control-label"></label>
            <input asp-for="Budget.Name" class="form-control" />
            <span asp-validation-for="Budget.Name" class="text-danger"></span>
        </div>
        <div class="col-12 mt-2">
            <label asp-for="Budget.Value" class="control-label"></label>
            <input asp-for="Budget.Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="Budget.Value" class="text-danger"></span>
        </div>
    </div>
    <div class="col-12 text-center mt-3">
        <button class="btn btn-primary w-100" asp-action="AddBudget">@Localizer["Add"]</button>
    </div>
    <div class="row text-center mt-4">
        <input type="hidden" asp-for="PeriodId" />
        <input type="hidden" asp-for="Period" />
        <input type="hidden" asp-for="Total" value="@Model.Total" />
        <p class="fs-4 mb-1">@Localizer["Budget"] @Model.Period: <strong class="text-primary">$ @Model.Total</strong></p>
    </div>
    <hr class="mt-0" />
    <h3 class="h3 text-center mb-3">@Localizer["_Budgets"] </h3>
    <ul class="list-group">
        @for (var i = 0; i < Model.Budgets.Count(); i++)
        {
            <li class="list-group-item p-0">
                <input type="hidden" asp-for="@Model.Budgets[i].Name" />
                <input type="hidden" asp-for="@Model.Budgets[i].Value" />
                <div class="row justify-content-end">
                    <button class="btn-close btn-danger" asp-route-index="@i" asp-action="RemoveBudget"></button>
                </div>
                <div class="row pb-3 ps-3 pe-3">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-6 col-md-6 fw-semibold text-primary"><h3 class="mb-0">@Model.Budgets[i].Name</h3></div>
                            <div class="col-6 col-md-6 text-end fw-semibold"><h3 class="text-success mb-0">$@Model.Budgets[i].Value</h3></div>
                        </div>
                    </div>
                </div>
            </li>
        }
    </ul>
    <div class="row justify-content-center align-items-center mt-3">
        <div class="col-12 text-center">
            <button class="btn btn-primary w-100" asp-action="SaveBudgets">@Localizer["Next"]</button>
        </div>
    </div>
    <div class="row justify-content-center align-items-center">
        <div class="col-12 text-center">
            <button class="btn btn-outline-primary w-100" asp-action="Savings">@Localizer["Skip"]</button>
        </div>
    </div>
</form>
