@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}
<div class="card">
    <div class="card-body">
        <div class="row mb-5 justify-content-center align-items-center">
            <div class="col-12 col-md-3">
                <img src="~/images/logos/logo.png" class="rounded mx-auto d-block" style="max-width:100%" />
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12 text-center mb-lg-0">
                <div class="avatar">
                </div>
            </div>
        </div>
        <div class="row text-center">
            <h1 class="text-black">Bienvenido Pepito</h1>
            <p class="mt-5">Configuremos tu perfil financiero paso a paso.</p>
        </div>
        <div class="row justify-content-center align-items-center">
            <div class="col-12 col-md-3 text-center">
                <button class="btn btn-primary w-100">Comencemos</button>
            </div>
            <div class="col-12 col-md-3 text-center">
                <button class="btn btn-outline-primary w-100">Saltar por ahora</button>
            </div>
        </div>
        <div class="row">
            <div class="hint">
                * Puedes saltar pasos y volver cuando quieras.
            </div>
        </div>
    </div>
</div>

