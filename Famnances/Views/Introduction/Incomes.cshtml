@model Famnances.Models.ViewModels.IntroductionIncomeViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewBag.Title = "Introduction";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="row justify-content-center align-items-center">
    <div class="col-md-4">
        <form asp-action="AddIncome">
            <div class="row mb-5 justify-content-center align-items-center">
                <div class="card">
                    <div class="card-body">
                        <h1 class="h3 text-center mb-2">@Localizer["Tittle"] </h1>
                        <p class="text-center mt-3">
                            @Localizer["Subtittle"]
                        </p>
                        <div class="col-12">
                            <label asp-for="NewIncome.Type" class="control-label text-start"></label>
                            <select asp-for="NewIncome.Type" class="form-control select2" data-live-search="true">
                                <option selected disabled hidden>Select</option>
                                <option value="FIXED">@Localizer["FIXED"]</option>
                                <option value="VARIABLE">@Localizer["VARIABLE"]</option>
                            </select>
                            <span asp-validation-for="NewIncome.Type" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NewIncome.Description" class="control-label text-start"></label>
                            <input asp-for="NewIncome.Description" class="form-control" />
                            <span asp-validation-for="NewIncome.Description" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NewIncome.Value" class="control-label text-start"></label>
                            <input asp-for="NewIncome.Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                            <span asp-validation-for="NewIncome.Value" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NewIncome.FirstPayDate" class="control-label text-start"></label>
                            <input asp-for="NewIncome.FirstPayDate" class="form-control" type="date" />
                            <span asp-validation-for="NewIncome.FirstPayDate" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NewIncome.PeriodId" class="control-label text-start"></label>
                            <select asp-for="NewIncome.PeriodId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true">
                                <option selected disabled hidden>Select</option>
                            </select>
                            <span asp-validation-for="NewIncome.PeriodId" class="text-danger"></span>
                        </div>
                        <div class="col-12 text-center">
                            <button class="btn btn-primary w-100" asp-action="AddIncome">@Localizer["Add"]</button>
                        </div>
                    </div>
                    <div class="row text-center">
                        <input type="hidden" asp-for="PeriodId" />
                        <input type="hidden" asp-for="Period" />
                        <input type="hidden" asp-for="Total" value="@Model.Total" />
                        <p>Total @Model.Period: <strong class="text-primary">$ @Model.Total</strong></p>                        
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h3 class="h3 text-center mb-2">@Localizer["_Incomes"] </h3>
                    <ul class="list-group">
                        @for (var i = 0; i < Model.Incomes.Count(); i++)
                        {
                            <li class="list-group-item">
                                <input type="hidden" asp-for="@Model.Incomes[i].Description" />
                                <input type="hidden" asp-for="@Model.Incomes[i].Period" />
                                <input type="hidden" asp-for="@Model.Incomes[i].PeriodId" />
                                <input type="hidden" asp-for="@Model.Incomes[i].FirstPayDate" />
                                <input type="hidden" asp-for="@Model.Incomes[i].Type" />
                                <input type="hidden" asp-for="@Model.Incomes[i].Value" />

                                <div class="row">
                                    <div class="col-4 col-md-4 fw-semibold text-primary"><h5 class="mb-0">@Model.Incomes[i].Description</h5></div>
                                    <div class="col-4 col-md-4 text-end fw-semibold"><h5 class="mb-0">@Model.Incomes[i].Period</h5></div>
                                    <div class="col-4 col-md-4 text-end fw-semibold"><h3 class="text-success mb-0">$@Model.Incomes[i].Value</h3></div>
                                </div>
                                <div class="row">
                                    <div class="col-4 col-md-4 align-self-end"><small class="mb-0">@Localizer[Model.Incomes[i].Type]</small></div>
                                </div>                                
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="row justify-content-center align-items-center mt-3">
                <div class="col-12 text-center">
                    <button class="btn btn-primary w-100" asp-action="SaveIncomes">@Localizer["Next"]</button>
                </div>
            </div>
            <div class="row justify-content-center align-items-center">
                <div class="col-12 text-center">
                    <button class="btn btn-outline-primary w-100">@Localizer["Skip"]</button>
                </div>
            </div>
        </form>
    </div>
</div>