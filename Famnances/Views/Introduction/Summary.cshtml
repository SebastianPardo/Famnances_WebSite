@model Famnances.Models.ViewModels.Introduction.SummaryViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewBag.Title = "Introduction";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}


<form asp-action="EndINtroduction">
    <h1 class="h3 text-center mb-2">@Localizer["Title"]</h1>
    <p class="text-center mt-3">@Localizer["Subtitle"]</p>
    @* <hr class="mt-0" /> *@
    <h3 class="h3 text-center mb-4 mt-4"><strong>@Model.Period</strong></h3>
    <div class="col-12 mt-3">
        <p class ="text-center h4 mb-1">@Localizer["Budget"]</p>
        <p class="text-center h5">$@Model.BudgetByPeriod </p>
    </div>
    <div class="col-12 mt-3">
        <p class="text-center h4 mb-1">@Localizer["CommittedMoney"]</p>
        @{
            decimal expenses = Model.BudgetByPeriod - Model.Total;
            decimal fixedExpenses = expenses - Model.SavingsByPeriod;
        }
        <p class="text-center h5 mb-1">$@expenses</p>
        <p class="text-center h6 mb-1">@Localizer["ExpensesScheduled"]: $@fixedExpenses</p>
        <p class="text-center h6">@Localizer["SavingScheduled"]: $@Model.SavingsByPeriod </p>
    </div>
    <div class="col-12 mt-3">
        <p class="text-center h4 mb-1">@Localizer["Availability"]</p>
        <p class="text-center h5">$@Model.Total </p>
    </div>
    <div class="col-12 mt-3">
        <p class="text-center h4 mb-1">@Localizer["Savings"]</p>
        <p class="text-center h5 mb-1">@Localizer["Acumulated"]: $@Model.Savings </p>
        <p class="text-center h6">@Localizer["Scheduled"]: $@Model.SavingsByPeriod </p>
    </div>
    <div class="col-12 mt-3">
        <p class="text-center h4 mb-1">@Localizer["Money"]</p>
        <label asp-for="CurrentMoney" class="control-label text-center"></label>
        <input asp-for="CurrentMoney" class="form-control" type="number" step="0.01" placeholder="00.00" />
        <span asp-validation-for="CurrentMoney" class="text-danger"></span>
    </div>
    <div class="row mt-4">
        <div class="col-12 text-center">
            <button class="btn btn-primary w-100">@Localizer["Finish"]</button>
        </div>
    </div>
</form>