@model Famnances.Models.ViewModels.Introduction.FinancialAccountViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@using Famnances.Helpers
@inject IViewLocalizer Localizer

@{
    ViewBag.Title = "Introduction";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@if (TempData[Constants.ERROR] != null)
{
    <div class="row">
        <div class="alert alert-danger alert-dismissible d-flex align-items-center" role="alert">
            <div class="avatar flex-shrink-0 me-2">
                <i class="bi bi-exclamation-circle fs-4" style="color:var(--bs-danger)"></i>
            </div>
            <div>@TempData[Constants.ERROR]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<form asp-action="AddFinancialAccount">
    <h1 class="h3 text-center mb-2">@Localizer["Tittle"] </h1>
    <p class="text-center mt-3">
        @Localizer["Subtittle"]
    </p>
    <div class="row">
        <div class="col-12 mt-2">
            <label asp-for="financialAccount.FinancialInstitutionId" class="control-label"></label>
            <select asp-for="financialAccount.FinancialInstitutionId" class="form-control select2" asp-items="@ViewBag.FinancialInstitutions" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
        </div>
        <div class="col-12 mt-2">
            <label asp-for="financialAccount.FinancialAccountTypeId" class="control-label"></label>
            <select asp-for="financialAccount.FinancialAccountTypeId" class="form-control select2" asp-items="@ViewBag.AccountTypes" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
        </div>
        <div class="col-12 mt-2">
            <label asp-for="financialAccount.Name" class="control-label"></label>
            <input asp-for="financialAccount.Name" class="form-control" />
            <span asp-validation-for="financialAccount.Name" class="text-danger"></span>
        </div>
        <div class="col-12 mt-2">
            <label asp-for="financialAccount.Amount" class="control-label"></label>
            <input asp-for="financialAccount.Amount" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="financialAccount.Amount" class="text-danger"></span>
        </div>
        <div class="col-12 mt-2">
            <label asp-for="financialAccount.CreatedDate" class="control-label"></label>
            <input asp-for="financialAccount.CreatedDate" class="form-control" type="date" />
            <span asp-validation-for="financialAccount.CreatedDate" class="text-danger"></span>
        </div>
    </div>
    <div class="col-12 text-center mt-3">
        <button class="btn btn-primary w-100" asp-action="AddFinancialAccount">@Localizer["Add"]</button>
    </div>
    <hr class="mt-0" />
    <h3 class="h3 text-center mb-3">@Localizer["_Accounts"] </h3>
    <ul class="list-group">
        @for (var i = 0; i < Model.financialAccounts.Count(); i++)
        {
            <li class="list-group-item p-0">
                <input type="hidden" asp-for="@Model.financialAccounts[i].Name" />
                <input type="hidden" asp-for="@Model.financialAccounts[i].Amount" />
                <input type="hidden" asp-for="@Model.financialAccounts[i].CreatedDate" />
                <input type="hidden" asp-for="@Model.financialAccounts[i].FinancialAccountTypeId" />
                <input type="hidden" asp-for="@Model.financialAccounts[i].FinancialAccountType.Name" />
                <input type="hidden" asp-for="@Model.financialAccounts[i].FinancialInstitutionId" />
                <input type="hidden" asp-for="@Model.financialAccounts[i].FinancialInstitution.Name" />
                <div class="row justify-content-end">
                    <button class="btn-close btn-danger" asp-route-index="@i" asp-action="RemoveFinancialAccount"></button>
                </div>
                <div class="row pb-3 ps-3 pe-3">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-6 col-md-6 fw-semibold text-primary"><h3 class="mb-0">@Model.financialAccounts[i].Name</h3></div>
                            <div class="col-6 col-md-6 text-end fw-semibold"><h3 class="text-success mb-0">$@Model.financialAccounts[i].Amount</h3></div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-12 text-start fw-semibold">
                                <h6 class="mb-0">
                                    @Model.financialAccounts[i].FinancialAccountType.Name - @Model.financialAccounts[i].FinancialInstitution.Name
                                </h6>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        }
    </ul>
    <div class="row justify-content-center align-items-center mt-3">
        <div class="col-12 text-center">
            <button class="btn btn-primary w-100" asp-action="SaveFinancialAccounts">@Localizer["Next"]</button>
        </div>
    </div>
</form>
