@model IEnumerable<Famnances.DataCore.Entities.IncomeDiscount>

@{
    ViewData["Title"] = "Index - Discounts";
}

<div class="d-flex justify-content-between">
    <div class="col-2 ms-3">
        <a class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="IncomeDiscounts" asp-action="Create">
            <i class="bi bi-plus-lg fs-4"></i>
        </a>
    </div>
    <div class="col col-9 text-body-primary text-end p-3">
        <h3 class="card-title"><strong>Income Discounts</strong></h3>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Active)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Value)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsPercentage)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsPrediscount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsTax)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Active)
                            {
                                <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" checked disabled />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" disabled />
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @if (item.IsPercentage)
                            {
                                <input class="form-check-input" type="checkbox" id="IsPercentage" name="IsPercentage" value="true" checked disabled />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="IsPercentage" name="IsPercentage" value="true" disabled />
                            }
                        </td>
                        <td>
                            @if (item.IsPrediscount)
                            {
                                <input class="form-check-input" type="checkbox" id="IsPrediscount" name="IsPrediscount" value="true" checked disabled />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="IsPrediscount" name="IsPrediscount" value="true" disabled />
                            }
                        </td>
                        <td>
                            @if (item.IsTax)
                            {
                                <input class="form-check-input" type="checkbox" id="IsTax" name="IsTax" value="true" checked disabled />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" id="IsTax" name="IsTax" value="true" disabled />
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" class="btn btn-secondary" asp-route-id="@item.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>