@model IEnumerable<Famnances.DataCore.Entities.IncomeDiscount>

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Index - Discounts";
}

<div class="d-flex justify-content-between">
    <div class="col-2 ms-3">
        <a class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="IncomeDiscounts" asp-action="Create">
            <i class="bi bi-plus-lg fs-4"></i>
        </a>
    </div>
    <div class="col col-9 text-body-primary text-end p-3">
        <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Active)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Value)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsPercentage)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsPrediscount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsTax)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Active)
                            {
                                <span class="badge bg-success">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@Localizer["Inactive"]</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @if (item.IsPercentage)
                            {
                                <span class="badge bg-warning">@Localizer["Yes"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@Localizer["No"]</span>
                            }
                        </td>
                        <td>
                            @if (item.IsPrediscount)
                            {
                                <span class="badge bg-warning">@Localizer["Before"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@Localizer["After"]</span>
                            }
                        </td>
                        <td>
                            @if (item.IsTax)
                            {
                                <span class="badge bg-warning">@Localizer["Yes"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@Localizer["No"]</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" class="btn btn-secondary" asp-route-id="@item.Id">@Localizer["Edit"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>