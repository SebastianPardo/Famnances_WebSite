@model Famnances.DataCore.Entities.IncomeDiscount

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Create - Discounts";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2 text-center">
                    <div class="btn-group btn-group-sm mb-3" role="group">
                        <input type="radio" asp-for="Active" class="btn-check" value="true" id="yesActiveOpt" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="yesActiveOpt">@Localizer["Active"]</label>

                        <input type="radio" asp-for="Active" class="btn-check" value="false" id="noActiveOpt" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="noActiveOpt">@Localizer["Inactive"]</label>
                    </div>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Description" class="control-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Value" class="control-label"></label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <label asp-for="IsPercentage" class="form-check-label"></label>
                </div>
                <div class="col-12 text-center">
                    <div class="btn-group btn-group-sm mb-3" role="group">
                        <input type="radio" asp-for="IsPercentage" class="btn-check" value="true" id="yesPercentageOpt" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="yesPercentageOpt">@Localizer["Yes"]</label>

                        <input type="radio" asp-for="IsPercentage" class="btn-check" value="false" id="noPercentageOpt" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="noPercentageOpt">@Localizer["No"]</label>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <label asp-for="IsPrediscount" class="form-check-label"></label>
                </div>
                <div class="col-12 text-center">
                    <div class="btn-group btn-group-sm mb-3" role="group">
                        <input type="radio" asp-for="IsPrediscount" class="btn-check" value="true" id="beforeOpt" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="beforeOpt">@Localizer["Before"]</label>

                        <input type="radio" asp-for="IsPrediscount" class="btn-check" value="false" id="afterOpt" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="afterOpt">@Localizer["After"]</label>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <label asp-for="IsTax" class="form-check-label"></label>
                </div>
                <div class="col-12 text-center">
                    <div class="btn-group btn-group-sm mb-3" role="group">
                        <input type="radio" asp-for="IsTax" class="btn-check" value="true" id="yesTaxOpt" autocomplete="off" checked />
                        <label class="btn btn-outline-primary" for="yesTaxOpt">@Localizer["Yes"]</label>

                        <input type="radio" asp-for="IsTax" class="btn-check" value="false" id="noTaxOpt" autocomplete="off" />
                        <label class="btn btn-outline-primary" for="noTaxOpt">@Localizer["No"]</label>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-primary w-100" value="@Localizer["Save"]" />
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
