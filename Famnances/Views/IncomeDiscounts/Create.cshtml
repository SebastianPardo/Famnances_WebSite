@model Famnances.DataCore.Entities.IncomeDiscount

@{
    ViewData["Title"] = "Create - Discounts";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title">Create <strong>Income discount</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                    </label>
                </div>
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsPercentage" /> @Html.DisplayNameFor(model => model.IsPercentage)
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsPrediscount" /> @Html.DisplayNameFor(model => model.IsPrediscount)
                    </label>
                </div>
                <div class="col-6 col-md-6 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsTax" /> @Html.DisplayNameFor(model => model.IsTax)
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Description" class="control-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Value" class="control-label"></label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-primary w-100" value="Save" />
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
