@using Microsoft.AspNetCore.Authentication.Facebook
@using Microsoft.AspNetCore.Authentication.Google

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="row text-center">
    <h3>Log in</h3>
</div>

<form asp-action="Index">
    <div class="row text-center justify-content-center mt-2">
        <div class="col-8">
            <label class="control-label text-start"></label>
            <input name="user" id="user" class="form-control" />
            <span class="text-danger"></span>
        </div>
    </div>
    <div class="row text-center justify-content-center mt-2">
        <div class="col-8 text-center">
            <input type="submit" value="Continue" class="btn btn-primary w-100" />
        </div>
        
    </div>
</form>
<div class="row text-center justify-content-center mt-4">
    <div class="col-8 text-center">
        <form asp-action="ExternalLogin" method="post">
            <input type="hidden" name="provider" value="@GoogleDefaults.AuthenticationScheme" />
            <button type="submit" alt="Submit" class="btn btn-outline-danger w-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                    <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z" />
                </svg>
                Sign in with Google
            </button>
        </form>
    </div>
</div>
@* <form asp-action="ExternalLogin" method="post">
                        <input type="hidden" name="provider" value="@FacebookDefaults.AuthenticationScheme" />
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-facebook"></i> Sign in with Facebook
                        </button>
                    </form> *@
<div class="row text-center mt-4">
    <a asp-action="Guest" class="link-primary">Login as Guest</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
