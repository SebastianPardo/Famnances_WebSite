@model Famnances.Models.ViewModels.LoginViewModel

@using Famnances.Helpers
@using Microsoft.AspNetCore.Authentication.Facebook
@using Microsoft.AspNetCore.Authentication.Google

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@if (TempData[Constants.ERROR] != null)
{
    <div class="row">
        <div class="alert alert-danger alert-dismissible d-flex align-items-center" role="alert">
            <div class="avatar flex-shrink-0 me-2">
                <img src="~/images/icons/alert.png"
                     alt="chart success"
                     class="rounded" />
            </div>
            <div>@TempData[Constants.ERROR]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}


<div class="row text-center">
    <h4>Log in</h4>
</div>
<form asp-action="Login">
    <input type="hidden" asp-for="Param_1" value="@TempData[Constants.EMAIL]" />
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Param_2" class="control-label text-start"></label>
                <input asp-for="Param_2" class="form-control" type="password" />
                <span asp-validation-for="Param_2" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row justify-content-center align-items-center mt-2">
        <div class="col-12 text-center">
            <input type="submit" value="Continue" class="btn btn-primary" />
        </div>
    </div>
</form>
<div class="row justify-content-center align-items-center mt-3">
    <div class="col-12 text-center">
        <a class="text-secondary w-100" asp-action="Language" asp-controller="Introduction">Create new account</a>
    </div>
</div>