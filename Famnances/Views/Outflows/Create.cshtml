@model Famnances.Models.ViewModels.OutflowViewModel

@{
    ViewData["Title"] = "Create - Outflow";
}
<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-md-3 me-5 text-body-primary text-end">
            <h3 class="card-title">Create <strong>Outflow</strong></h3>
        </div>
    </div>
</div>
<hr />
<form asp-action="@(Model.OverSpent == null ? "Create" : "Overspent")" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.OverSpent != null)
    {
        <input type="hidden" asp-for="Outflow.ExpenseBudgetId" />
        <input type="hidden" asp-for="Outflow.Description" />
        <input type="hidden" asp-for="Outflow.Value" />
        <input type="hidden" asp-for="Outflow.TransactionDate" />
    }


    <div class="row">
        <div class="col-md-3">
            <label asp-for="Outflow.ExpenseBudgetId" class="control-label"></label>
            <select asp-for="Outflow.ExpenseBudgetId" class="form-control select2" asp-items="@ViewBag.ExpenseBudgetId" data-live-search="true" disabled="@(Model.OverSpent != null)">
                <option selected disabled hidden>Select</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Outflow.Description" class="control-label"></label>
            <input asp-for="Outflow.Description" class="form-control" disabled="@(Model.OverSpent != null)" />
            <span asp-validation-for="Outflow.Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Outflow.Value" class="control-label"></label>
            <input asp-for="Outflow.Value" class="form-control" type="number" step="0.01" placeholder="00.00" disabled="@(Model.OverSpent != null)" />
            <span asp-validation-for="Outflow.Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Outflow.TransactionDate" class="control-label"></label>
            <input asp-for="Outflow.TransactionDate" class="form-control" type="date" disabled="@(Model.OverSpent != null)" />
            <span asp-validation-for="Outflow.TransactionDate" class="text-danger"></span>
        </div>
    </div>
    @if (Model.OverSpent != null)
    {
        @await Component.InvokeAsync("Overspent", new { model = Model.OverSpent })
    }
    <div class="row justify-content-center mt-3">
        <div class="col-md-2">
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
