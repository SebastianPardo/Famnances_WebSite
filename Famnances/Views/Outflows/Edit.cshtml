@using Famnances.Helpers
@model Famnances.Models.ViewModels.OutflowViewModel

@{
    ViewData["Title"] = "Edit - Outflow";
}

<div class="d-flex justify-content-end">
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title">Edit @Model.Outflow.Description <strong>Outflow</strong></h3>
    </div>
</div>
<hr />
<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Outflow.Id" />
    <div class="row">
        <div class="col-md-3">
            <label asp-for="Outflow.ExpenseBudgetId" class="control-label"></label>
            <select asp-for="Outflow.ExpenseBudgetId" class="form-control select2" asp-items="@ViewBag.ExpenseBudgetId" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
            <span asp-validation-for="Outflow.ExpenseBudgetId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Outflow.Description" class="control-label"></label>
            <input asp-for="Outflow.Description" class="form-control" />
            <span asp-validation-for="Outflow.Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Outflow.Value" class="control-label"></label>
            <input asp-for="Outflow.Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="Outflow.Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Outflow.TransactionDate" class="control-label"></label>
            <input asp-for="Outflow.TransactionDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Outflow.TransactionDate" class="text-danger"></span>
        </div>
    </div>
    @if (Model.OverSpent != null)
    {
        @await Component.InvokeAsync("Overspent", new { model = Model.OverSpent })
    }
    <div class="row justify-content-center mt-3">
        <div class="col-8 col-md-2">
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-4 col-md-2">
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("Delete", new { id = Model.Outflow.Id })" formmethod="post" />
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/Outflows/Overspent.js"></script>
}
