@model Famnances.DataCore.Entities.Outflow

@{
    ViewData["Title"] = "Edit - Outflow";
}

<div class="d-flex justify-content-end">
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title">Edit @Model.Description <strong>Outflow</strong></h3>
    </div>
</div>
<hr />
<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-3">
            <label asp-for="ExpenseBudgetId" class="control-label"></label>
            <select asp-for="ExpenseBudgetId" class="form-control select2" asp-items="@ViewBag.ExpenseBudgetId" data-live-search="true">
                <option selected disabled hidden>Select</option>
            </select>
            <span asp-validation-for="ExpenseBudgetId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Value" class="control-label"></label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="TransactionDate" class="control-label"></label>
            <input asp-for="TransactionDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="TransactionDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row justify-content-center mt-3">
        <div class="col-8 col-md-2">
            <input type="submit" class="btn btn-primary form-control" value="Save" />
        </div>
        <div class="col-4 col-md-2">
            <input type="submit" class="btn btn-danger form-control" value="Delete" formaction="@Url.Action("Delete")" formmethod="post" />
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
