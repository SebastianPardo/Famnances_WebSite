@model Famnances.DataCore.Entities.FixedExpense

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Create - Fixed Expenses";
}
<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <form asp-action="CreateFixedExpenses">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-12 col-md-12 text-center">
                <div class="btn-group btn-group-sm" role="group">
                    <input type="radio" asp-for="Active" class="btn-check" value="true" id="Active" autocomplete="off" />
                    <label class="btn btn-outline-primary" for="Active">@Localizer["Active"]</label>
                    <input type="radio" asp-for="Active" class="btn-check" value="false" id="Inactive" autocomplete="off" checked />
                    <label class="btn btn-outline-primary" for="Inactive">@Localizer["Inactive"]</label>
                </div>
            </div>
            <div class="col-12 col-md-12 mt-2">
                <label asp-for="ShareOnHousehold" class="form-check-label"></label>
            </div>
            <div class="col-12 col-md-12 text-center">
                <div class="btn-group btn-group-sm" role="group">
                    <input type="radio" asp-for="ShareOnHousehold" class="btn-check" value="true" id="Share" autocomplete="off" />
                    <label class="btn btn-outline-primary" for="Share">@Localizer["Yes"]</label>
                    <input type="radio" asp-for="ShareOnHousehold" class="btn-check" value="false" id="NoShare" autocomplete="off" checked />
                    <label class="btn btn-outline-primary" for="NoShare">@Localizer["No"]</label>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="Value" class="control-label"></label>
                    <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="StartDate" class="control-label"></label>
                    <input asp-for="StartDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="EndDate" class="control-label"></label>
                    <input asp-for="EndDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-12 mt-2">
                    <label asp-for="PeriodId" class="control-label"></label>
                    <select asp-for="PeriodId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true">
                        <option selected disabled hidden>@Localizer["Select"]</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center mt-3">
                <input type="submit" class="btn btn-primary w-100" value="@Localizer["Save"]" />
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
