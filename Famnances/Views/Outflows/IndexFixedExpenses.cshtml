@model IEnumerable<Famnances.DataCore.Entities.FixedExpense>

@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Index - Fixed Expenses";
    Layout = "~/Views/Shared/_IndexLayout.cshtml";
}

<div class="d-flex justify-content-between">
    <div class="col-2 ms-3">
        <a class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Outflows" asp-action="CreateFixedExpenses">
            <i class="bi bi-plus-lg fs-4"></i>
        </a>
    </div>
    <div class="col col-9 text-body-primary text-end p-3">
        <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>@Localizer["Status"]</th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Value)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.StartDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.EndDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Period)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Active)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.FixedExpensesPaymentsRecord == null || item.FixedExpensesPaymentsRecord.Count == 0)
                            {
                                <form asp-action="PayFixedExpenses" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-tertiary w-100">@Localizer["Pay"]</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success">@Localizer["Paid"]</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Value)
                        </td>
                        <td>
                            @item.StartDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            @if (item.EndDate != null)
                            {
                                @item.EndDate.Value.ToString("dd MMM yyyy")
                            }
                        </td>
                        <td>
                            @switch (CultureInfo.CurrentCulture.Name)
                            {
                                case "ES":
                                case "es-CO":
                                    <p>@item.Period.NameES</p>
                                    break;
                                case "EN":
                                case "en-CA":
                                    <p>@item.Period.NameEN</p>
                                    break;
                                case "FR":
                                case "fr-CA":
                                    <p>@item.Period.NameFR</p>
                                    break;
                            }
                        </td>
                        <td>
                            @if (item.Active)
                            {
                                <span class="badge bg-success">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@Localizer["Inactive"]</span>
                            }
                        </td>
                        <td>
                            <a asp-action="DetailsFixedExpenses" class="btn btn-secondary btn-sm w-100" asp-route-id="@item.Id">@Localizer["Details"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
