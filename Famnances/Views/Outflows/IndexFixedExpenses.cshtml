@model IEnumerable<Famnances.DataCore.Entities.FixedExpense>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between">
    <div class="ms-3 mb-3 mt-1">
        <a type="button" class="btn btn-lg rounded-pill btn-icon btn-primary card-header" asp-controller="Outflows" asp-action="CreateFixedExpenses" formmethod="get">
            <span class="tf-icons bx bx-plus"></span>
        </a>
    </div>
    <div class="col-md-1 me-5 text-body-primary text-end">
        <h2 class="card-title"><strong>Index</strong></h2>
        <h5 class="card-subtitle">Fixed Expenses</h5>
    </div>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Active)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Value)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Period)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item.Active)
                    {
                        <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" checked disabled />
                    }
                    else
                    {
                        <input class="form-check-input" type="checkbox" id="Active" name="Active" value="true" disabled />
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Value)
                </td>
                <td>
                    @item.StartDate.ToString("dd MMM yyyy")
                </td>
                <td>
                    @if (item.EndDate != null)
                    {
                        @item.EndDate.Value.ToString("dd MMM yyyy")
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Period.Name)
                </td>
                <td>
                    <div class="row">
                        <div class="col-auto">
                            <a asp-action="DetailsFixedExpenses" class="btn btn-secondary" asp-route-id="@item.Id">Details</a>
                        </div>
                        <div class="col-auto">
                            @if (item.FixedExpensesPaymentsRecord == null || item.FixedExpensesPaymentsRecord.Count == 0)
                            {
                                <form asp-action="PayFixedExpenses" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-indigo">Pay</button>
                                </form>
                            }
                            else
                            {
                                <h5 class="text-success mb-0">Paid</h5>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
