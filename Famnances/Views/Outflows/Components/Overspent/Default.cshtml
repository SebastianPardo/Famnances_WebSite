@model Famnances.Models.ViewModels.OutflowViewModel

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer


<div class="card minicard">
    <div class="card-body">
        <div class="row mt-3">
            <div class="d-flex justify-content-end">
                <div class="col text-body-primary text-end">
                    <h5 class="text-start text-danger">@Localizer["Statement1"] @Model.OverSpent.OverSpentValue @Localizer["Statement2"] </h5>
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="OverSpent.FullValue" />
        <input type="hidden" asp-for="OverSpent.OverSpentValue" />
        <div class="row justify-content-center mb-2">
            <div class="col-12 col-md-12 text-center">
                <div class="btn-group mb-3" role="group">
                    <input type="radio" asp-for="OverSpent.IsFull" class="btn-check" value="true" id="fullOption" autocomplete="off" checked />
                    <label class="btn btn-outline-primary" for="fullOption">@Localizer["How1"] (@Model.OverSpent.FullValue)</label>

                    <input type="radio" asp-for="OverSpent.IsFull" class="btn-check" value="false" id="overOption" autocomplete="off" />
                    <label class="btn btn-outline-primary" for="overOption">@Localizer["How2"] (@Model.OverSpent.OverSpentValue)</label>
                </div>
            </div>
            <div class="col-12 col-md-12 text-center">
                <div class="btn-group mb-2" role="group">
                    <input type="radio" asp-for="OverSpent.IsSaving" class="btn-check move-option" value="false" id="budgetOption" autocomplete="off" />
                    <label class="btn btn-outline-primary" for="budgetOption">@Localizer["Where1"]</label>

                    <input type="radio" asp-for="OverSpent.IsSaving" class="btn-check move-option" value="true" id="savingOption" autocomplete="off" checked />
                    <label class="btn btn-outline-primary" for="savingOption">@Localizer["Where2"]</label>
                </div>
            </div>
            <div class="col-12 col-md-12 budgets d-none">
                <select asp-for="OverSpent.IdSelected" asp-items="ViewBag.ExpensesBudgets" class="form-control select2">
                    <option selected disabled hidden>@Localizer["Select"]</option>
                </select>
            </div>

            <div class="col-12 col-md-12 pockets">
                <select asp-for="OverSpent.IdSelected" asp-items="ViewBag.SavingPockets" class="form-control select2">
                    <option selected disabled hidden>@Localizer["Select"]</option>
                </select>
            </div>
        </div>
    </div>
</div>