@model Famnances.DataCore.Entities.FixedExpense

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Details - Fixed Expenses";
}

<div class="row">
    <div class="d-flex justify-content-end">
        <div class="col col-12 text-body-primary text-end">
            <h3 class="card-title"><strong>@Localizer["Title"]</strong></h3>
        </div>
    </div>
</div>
<div class="card minicard">
    <div class="card-body">
        <div class="col-12 col-md-12 mt-2 text-center">
            @if (Model.Active)
            {
                <span class="badge bg-success">@Localizer["Active"]</span>
            }
            else
            {
                <span class="badge bg-danger">@Localizer["Inactive"]</span>
            }
        </div>
        <div class="col-12 col-md-12 mt-2">
            <label class="form-check-label">@Html.DisplayNameFor(model => model.ShareOnHousehold)</label>
            @if (Model.ShareOnHousehold)
            {
                <span class="badge bg-success">@Localizer["Yes"]</span>
            }
            else
            {
                <span class="badge bg-danger">@Localizer["No"]</span>
            }
        </div>
        <div class="col-12 col-md-12 mt-2">
            <label asp-for="Value" class="control-label"></label>
            <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" readonly />
            <span asp-validation-for="Value" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-12 mt-2">
            <label asp-for="PeriodId" class="control-label"></label>
            <select asp-for="PeriodId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true" disabled>
                <option selected disabled hidden>@Localizer["Select"]</option>
            </select>
        </div>
        <div class="col-12 col-md-12 mt-2">
            <label asp-for="StartDate" class="control-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" readonly />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-12 mt-2">
            <label asp-for="EndDate" class="control-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" readonly />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-12 text-center mt-3">
            <a asp-action="EditFixedExpenses" class="btn btn-secondary w-100" asp-route-id="@Model.Id">@Localizer["Edit"]</a>
        </div>
    </div>
    <div class="row">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>
                        @Localizer["PaymentDate"]
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FixedExpensesPaymentsRecord)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.PaymentDate)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
