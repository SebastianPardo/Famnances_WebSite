@model Famnances.DataCore.Entities.FixedExpense

@{
    ViewData["Title"] = "Details - Fixed Expenses";
}

<div class="d-flex justify-content-end">
    <div class="col col-md-3 me-5 text-body-primary text-end">
        <h3 class="card-title">@Model.Name <strong>Fixed Expense</strong></h3>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-3">
        <div class="row">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="Active" disabled />  @Html.DisplayNameFor(model => model.Active)
            </label>
        </div>
        <div class="row">

            <label class="form-check-label">
                <input class="form-check-input" asp-for="ShareOnHousehold" disabled />  @Html.DisplayNameFor(model => model.ShareOnHousehold)
            </label>
        </div>
    </div>
    <div class="col-md-3">
        <label asp-for="Value" class="control-label"></label>
        <input asp-for="Value" class="form-control" type="number" step="0.01" placeholder="00.00" readonly />
        <span asp-validation-for="Value" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="PeriodId" class="control-label"></label>
        <select asp-for="PeriodId" class="form-control select2" asp-items="@ViewBag.Periods" data-live-search="true" disabled>
            <option selected disabled hidden>Select</option>
        </select>
        <span asp-validation-for="PeriodId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="StartDate" class="control-label"></label>
        <input asp-for="StartDate" class="form-control" type="date" readonly />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <label asp-for="EndDate" class="control-label"></label>
        <input asp-for="EndDate" class="form-control" type="date" readonly />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <div class="row">
            <label class="control-label">&nbsp;</label>
        </div>
        <a asp-action="EditFixedExpenses" class="btn btn-secondary" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>
<div class="row">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>
                    Date payment record
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FixedExpensesPaymentsRecord)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.PaymentDate)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
